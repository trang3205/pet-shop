<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-shield-check"></i> Verify Admin Access
                    </h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        We have sent an OTP code to this account's email address. Please check your email and enter the OTP code to verify your admin role.
                    </p>

                    {{#if error}}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> {{error}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {{/if}}

                    <form action="/account/verify-admin-otp" method="POST">
                        <input type="hidden" name="email" value="{{email}}">
                        
                        <!-- OTP Code -->
                        <div class="mb-4">
                            <label for="otp_code" class="form-label">OTP Code</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input type="text" 
                                       class="form-control" 
                                       id="otp_code" 
                                       name="otp_code" 
                                       placeholder="Enter 6-digit OTP code"
                                       maxlength="6"
                                       required
                                       autofocus>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-dark w-100 mb-3">
                            <i class="bi bi-check-circle"></i> Verify & Login
                        </button>
                    </form>

                    <!-- Back Link -->
                    <div class="text-center">
                        <a href="/admin/login" class="text-muted small">
                            <i class="bi bi-arrow-left"></i> Back to Admin Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
