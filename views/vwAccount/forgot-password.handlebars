<!-- views/vwAccount/forgot-password.handlebars -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0 text-center">
                        <i class="bi bi-shield-lock"></i> Quên mật khẩu
                    </h4>
                </div>
                <div class="card-body p-4">
                    <!-- Step Indicator -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="step text-center">
                            <div class="step-circle {{#if step}}active{{/if}}">1</div>
                            <small>Nhập email</small>
                        </div>
                        <div class="step-line"></div>
                        <div class="step text-center">
                            <div class="step-circle {{#if step}}active{{/if}}">2</div>
                            <small>Mật khẩu mới</small>
                        </div>
                        <div class="step-line"></div>
                        <div class="step text-center">
                            <div class="step-circle">3</div>
                            <small>Xác thực OTP</small>
                        </div>
                    </div>

                    {{#if error}}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        {{error}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {{/if}}

                    {{#if success}}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>
                        {{success}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {{/if}}

                    <!-- Step 1: Enter Email -->
                    <div id="step1" {{#if step}}style="display: none;"{{/if}}>
                        <form action="/account/forgot-password" method="POST">
                            <div class="mb-4">
                                <p class="text-muted">
                                    Nhập email đã đăng ký tài khoản. Chúng tôi sẽ gửi mã OTP để xác thực.
                                </p>
                            </div>
                            
                            <div class="mb-3">
                                <label for="email" class="form-label">Email *</label>
                                <input type="email" class="form-control" id="email" name="email" 
                                       value="{{email}}" required placeholder="Nhập email của bạn">
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-arrow-right"></i> Tiếp theo
                                </button>
                                <a href="/account/login" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
                                </a>
                            </div>
                        </form>
                    </div>

                    <!-- Step 2: New Password (with OTP) -->
                    <div id="step2" {{#unless step}}style="display: none;"{{/unless}}>
                        <form id="resetPasswordForm">
                            <input type="hidden" name="email" value="{{email}}">
                            
                            <div class="mb-4">
                                <p class="text-muted">
                                    Mã OTP đã được gửi đến <strong>{{email}}</strong>. 
                                    Vui lòng kiểm tra email và nhập mã OTP cùng mật khẩu mới.
                                </p>
                            </div>

                            <div class="mb-3">
                                <label for="otp_code" class="form-label">Mã OTP *</label>
                                <input type="text" class="form-control" id="otp_code" name="otp_code" 
                                       required maxlength="6" placeholder="Nhập 6 chữ số">
                                <div class="form-text">
                                    <a href="#" id="resendOtp" class="text-decoration-none">
                                        <i class="bi bi-arrow-clockwise"></i> Gửi lại mã OTP
                                    </a>
                                    <span id="countdown" class="text-muted ms-2"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="new_password" class="form-label">Mật khẩu mới *</label>
                                <input type="password" class="form-control" id="new_password" 
                                       name="new_password" required minlength="6">
                                <div class="form-text">Mật khẩu phải có ít nhất 6 ký tự</div>
                            </div>

                            <div class="mb-3">
                                <label for="confirm_password" class="form-label">Xác nhận mật khẩu *</label>
                                <input type="password" class="form-control" id="confirm_password" 
                                       name="confirm_password" required>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-check-circle"></i> Đổi mật khẩu
                                </button>
                                <button type="button" id="btnBack" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left"></i> Quay lại
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Security Tips -->
            <div class="card mt-3">
                <div class="card-body">
                    <h6 class="mb-3"><i class="bi bi-shield-check"></i> Lưu ý bảo mật</h6>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li><i class="bi bi-check text-success"></i> Mã OTP chỉ có hiệu lực trong 10 phút</li>
                        <li><i class="bi bi-check text-success"></i> Không chia sẻ mã OTP với bất kỳ ai</li>
                        <li><i class="bi bi-check text-success"></i> Sử dụng mật khẩu mạnh, khó đoán</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .step {
        position: relative;
        flex: 1;
    }
    
    .step-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #e9ecef;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 8px;
        font-weight: bold;
        transition: all 0.3s;
    }
    
    .step-circle.active {
        background-color: #0d6efd;
        color: white;
    }
    
    .step-line {
        flex: 1;
        height: 2px;
        background-color: #e9ecef;
        margin: 0 10px;
        position: relative;
        top: -20px;
    }
</style>

<script>
    let countdownInterval;
    const email = "{{email}}";

    // Back button
    document.getElementById('btnBack')?.addEventListener('click', function() {
        window.location.href = '/account/forgot-password';
    });

    // Resend OTP
    document.getElementById('resendOtp')?.addEventListener('click', async function(e) {
        e.preventDefault();
        
        try {
            const response = await fetch('/account/forgot-password/resend-otp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ email: email })
            });

            const result = await response.json();

            if (result.success) {
                showAlert(result.message, 'success');
                startCountdown(600); // Reset countdown
            } else {
                showAlert(result.message, 'error');
            }
        } catch (error) {
            console.error('Error resending OTP:', error);
            showAlert('Có lỗi xảy ra khi gửi lại mã OTP', 'error');
        }
    });

    // Form submission
    document.getElementById('resetPasswordForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        const formData = new FormData(this);
        const data = Object.fromEntries(formData);

        // Validate passwords match
        if (data.new_password !== data.confirm_password) {
            showAlert('Mật khẩu xác nhận không khớp', 'error');
            return;
        }

        if (data.new_password.length < 6) {
            showAlert('Mật khẩu phải có ít nhất 6 ký tự', 'error');
            return;
        }

        try {
            const response = await fetch('/account/forgot-password/reset', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (result.success) {
                showAlert('Đổi mật khẩu thành công! Đang chuyển hướng...', 'success');
                setTimeout(() => {
                    window.location.href = '/account/login';
                }, 2000);
            } else {
                showAlert(result.message, 'error');
            }
        } catch (error) {
            console.error('Error resetting password:', error);
            showAlert('Có lỗi xảy ra khi đổi mật khẩu', 'error');
        }
    });

    // Countdown function
    function startCountdown(seconds) {
        clearInterval(countdownInterval);
        
        const countdownElement = document.getElementById('countdown');
        const resendLink = document.getElementById('resendOtp');
        
        if (!countdownElement || !resendLink) return;

        resendLink.style.pointerEvents = 'none';
        resendLink.style.opacity = '0.5';

        function updateCountdown() {
            const minutes = Math.floor(seconds / 60);
            const remainingSeconds = seconds % 60;
            
            countdownElement.textContent = `(${minutes}:${remainingSeconds.toString().padStart(2, '0')})`;
            
            if (seconds <= 0) {
                clearInterval(countdownInterval);
                countdownElement.textContent = '';
                resendLink.style.pointerEvents = 'auto';
                resendLink.style.opacity = '1';
            } else {
                seconds--;
            }
        }

        updateCountdown();
        countdownInterval = setInterval(updateCountdown, 1000);
    }

    // Start countdown if on step 2
    {{#if step}}
    startCountdown(600); // 10 minutes
    {{/if}}

    // Helper function to show alerts
    function showAlert(message, type) {
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type === 'error' ? 'danger' : 'success'} alert-dismissible fade show position-fixed`;
        alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        alertDiv.innerHTML = `
            <div class="d-flex align-items-center">
                <i class="bi ${type === 'error' ? 'bi-exclamation-triangle' : 'bi-check-circle'} me-2"></i>
                <span>${message}</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        document.body.appendChild(alertDiv);
        
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.classList.remove('show');
                alertDiv.classList.add('fade');
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.parentNode.removeChild(alertDiv);
                    }
                }, 150);
            }
        }, 4000);
    }
</script>