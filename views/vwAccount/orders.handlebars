<div class="container mt-4">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-person-circle"></i> Tài khoản của tôi</h6>
                </div>
                <div class="list-group list-group-flush">
                    <a href="/account/profile" class="list-group-item list-group-item-action">
                        <i class="bi bi-person me-2"></i>Thông tin cá nhân
                    </a>
                    <a href="/account/orders" class="list-group-item list-group-item-action active">
                        <i class="bi bi-bag me-2"></i>Đơn hàng của tôi
                    </a>
                    <a href="/user/wishlist" class="list-group-item list-group-item-action">
                        <i class="bi bi-heart me-2"></i>Sản phẩm yêu thích
                    </a>
                    <a href="/account/reviews" class="list-group-item list-group-item-action">
                        <i class="bi bi-star me-2"></i>Đánh giá của tôi
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-9">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0"><i class="bi bi-bag me-2"></i>Đơn hàng của tôi</h4>
                </div>
                <div class="card-body">
                    {{#if error}}
                        <div class="alert alert-danger">{{error}}</div>
                    {{/if}}

                    {{#if orders.length}}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã đơn hàng</th>
                                        <th>Ngày đặt</th>
                                        <th>Số sản phẩm</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each orders}}
                                    <tr>
                                        <td>
                                            <strong>#{{this.order_number}}</strong>
                                        </td>
                                        <td>{{this.created_at_formatted}}</td>
                                        <td>{{this.total_items}} sản phẩm</td>
                                        <td class="fw-bold text-primary">{{formatCurrency this.total_amount}}</td>
                                        <td>
                                            <span class="badge {{this.status_badge_class}}">
                                                {{getStatusText this.order_status}}
                                            </span>
                                        </td>
                                        <td>
                                            <a href="/account/orders/{{this.id}}" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Xem chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    {{else}}
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="bi bi-bag-x display-1 text-muted"></i>
                            </div>
                            <h5 class="text-muted">Chưa có đơn hàng nào</h5>
                            <p class="text-muted">Hãy bắt đầu mua sắm và khám phá các sản phẩm cho thú cưng của bạn!</p>
                            <a href="/categories" class="btn btn-primary">
                                <i class="bi bi-cart-plus"></i> Mua sắm ngay
                            </a>
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table th {
        border-top: none;
        font-weight: 600;
    }
    
    .list-group-item.active {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
    
    .badge {
        font-size: 0.75em;
    }
</style>