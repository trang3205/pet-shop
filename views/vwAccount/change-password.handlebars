<!-- views/vwAccount/change-password.handlebars -->
<div class="container mt-4">
    <div class="row">
        <!-- Sidebar Menu -->
        <div class="col-lg-3 mb-4">
            <div class="card">
                <div class="card-body">
                    <!-- User Info -->
                    <div class="text-center mb-4">
                        <img src="{{user.avatar_url}}" class="rounded-circle mb-3" 
                             alt="{{user.name}}" width="80" height="80"
                             onerror="this.src='/static/imgs/users/default-avatar.jpg'">
                        <h5 class="mb-1">{{user.name}}</h5>
                        <p class="text-muted mb-2">{{user.email}}</p>
                        <span class="badge bg-primary">{{user.role}}</span>
                    </div>

                    <!-- Navigation Menu -->
                    <div class="list-group list-group-flush">
                        <a href="/account/profile" class="list-group-item list-group-item-action">
                            <i class="bi bi-person"></i> Thông tin cá nhân
                        </a>
                        <a href="/account/change-password" class="list-group-item list-group-item-action active">
                            <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                        </a>
                        <a href="/user/wishlist" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-heart text-danger"></i> Sản phẩm yêu thích</span>
                            <span class="badge bg-danger rounded-pill">{{stats.wishlist}}</span>
                        </a>
                        <a href="/cart" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-cart3 text-primary"></i> Giỏ hàng</span>
                            <span class="badge bg-primary rounded-pill">{{stats.cart}}</span>
                        </a>
                        <a href="/account/orders" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-bag text-success"></i> Đơn hàng</span>
                            <span class="badge bg-success rounded-pill">{{stats.orders}}</span>
                        </a>
                    </div>

                    <!-- Logout -->
                    <div class="mt-3">
                        <form action="/account/logout" method="POST">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                </h1>
                <a href="/account/profile" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <!-- Change Password Form -->
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-key"></i> Bảo mật tài khoản
                    </h5>
                </div>
                <div class="card-body">
                    <form id="changePasswordForm">
                        <!-- Step 1: Current Password & New Password -->
                        <div id="step1">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Mật khẩu hiện tại *</label>
                                    <input type="password" class="form-control" name="current_password" 
                                           id="current_password" required>
                                    <div class="form-text">Nhập mật khẩu hiện tại của bạn</div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Mật khẩu mới *</label>
                                    <input type="password" class="form-control" name="new_password" 
                                           id="new_password" required minlength="6">
                                    <div class="form-text">Mật khẩu phải có ít nhất 6 ký tự</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Xác nhận mật khẩu *</label>
                                    <input type="password" class="form-control" name="confirm_password" 
                                           id="confirm_password" required>
                                    <div class="form-text">Nhập lại mật khẩu mới</div>
                                </div>
                            </div>

                            <button type="button" id="btnNext" class="btn btn-primary">
                                <i class="bi bi-arrow-right"></i> Tiếp theo
                            </button>
                        </div>

                        <!-- Step 2: OTP Verification -->
                        <div id="step2" style="display: none;">
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> 
                                Mã OTP đã được gửi đến email <strong>{{user.email}}</strong>. 
                                Mã có hiệu lực trong 10 phút.
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Mã OTP *</label>
                                    <input type="text" class="form-control" name="otp_code" 
                                           id="otp_code" required maxlength="6" 
                                           placeholder="Nhập 6 chữ số">
                                    <div class="form-text">
                                        <a href="#" id="resendOtp" class="text-decoration-none">
                                            <i class="bi bi-arrow-clockwise"></i> Gửi lại mã OTP
                                        </a>
                                        <span id="countdown" class="text-muted ms-2"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" id="btnBack" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left"></i> Quay lại
                                </button>
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-check-circle"></i> Xác nhận đổi mật khẩu
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Security Tips -->
            <div class="card mt-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-shield-check"></i> Mẹo bảo mật</h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li><i class="bi bi-check text-success"></i> Sử dụng mật khẩu có ít nhất 8 ký tự</li>
                        <li><i class="bi bi-check text-success"></i> Kết hợp chữ hoa, chữ thường, số và ký tự đặc biệt</li>
                        <li><i class="bi bi-check text-success"></i> Không sử dụng mật khẩu dễ đoán như "123456"</li>
                        <li><i class="bi bi-check text-success"></i> Đổi mật khẩu định kỳ 3-6 tháng một lần</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let otpSent = false;
    let countdownInterval;

    // Step navigation
    document.getElementById('btnNext').addEventListener('click', async function() {
        // Validate step 1
        const currentPassword = document.getElementById('current_password').value;
        const newPassword = document.getElementById('new_password').value;
        const confirmPassword = document.getElementById('confirm_password').value;

        if (!currentPassword || !newPassword || !confirmPassword) {
            showAlert('Vui lòng điền đầy đủ thông tin', 'error');
            return;
        }

        if (newPassword.length < 6) {
            showAlert('Mật khẩu mới phải có ít nhất 6 ký tự', 'error');
            return;
        }

        if (newPassword !== confirmPassword) {
            showAlert('Mật khẩu xác nhận không khớp', 'error');
            return;
        }

        // Send OTP
        try {
            const response = await fetch('/account/change-password/send-otp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ current_password: currentPassword })
            });

            const result = await response.json();

            if (result.success) {
                // Show step 2
                document.getElementById('step1').style.display = 'none';
                document.getElementById('step2').style.display = 'block';
                otpSent = true;
                
                // Start countdown
                startCountdown(600); // 10 minutes
                
                showAlert('Mã OTP đã được gửi đến email của bạn', 'success');
            } else {
                showAlert(result.message, 'error');
            }
        } catch (error) {
            console.error('Error sending OTP:', error);
            showAlert('Có lỗi xảy ra khi gửi mã OTP', 'error');
        }
    });

    document.getElementById('btnBack').addEventListener('click', function() {
        document.getElementById('step1').style.display = 'block';
        document.getElementById('step2').style.display = 'none';
        clearInterval(countdownInterval);
        document.getElementById('countdown').textContent = '';
    });

    // Resend OTP
    document.getElementById('resendOtp').addEventListener('click', async function(e) {
        e.preventDefault();
        
        if (!otpSent) return;

        try {
            const response = await fetch('/account/change-password/resend-otp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            const result = await response.json();

            if (result.success) {
                showAlert('Mã OTP mới đã được gửi', 'success');
                startCountdown(600); // Reset countdown
            } else {
                showAlert(result.message, 'error');
            }
        } catch (error) {
            console.error('Error resending OTP:', error);
            showAlert('Có lỗi xảy ra khi gửi lại mã OTP', 'error');
        }
    });

    // Form submission
    document.getElementById('changePasswordForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        if (!otpSent) {
            showAlert('Vui lòng xác thực OTP trước', 'error');
            return;
        }

        const formData = new FormData(this);
        const data = Object.fromEntries(formData);

        try {
            const response = await fetch('/account/change-password/verify', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (result.success) {
                showAlert('Đổi mật khẩu thành công!', 'success');
                setTimeout(() => {
                    window.location.href = '/account/profile';
                }, 2000);
            } else {
                showAlert(result.message, 'error');
            }
        } catch (error) {
            console.error('Error changing password:', error);
            showAlert('Có lỗi xảy ra khi đổi mật khẩu', 'error');
        }
    });

    // Countdown function
    function startCountdown(seconds) {
        clearInterval(countdownInterval);
        
        const countdownElement = document.getElementById('countdown');
        const resendLink = document.getElementById('resendOtp');
        
        resendLink.style.pointerEvents = 'none';
        resendLink.style.opacity = '0.5';

        function updateCountdown() {
            const minutes = Math.floor(seconds / 60);
            const remainingSeconds = seconds % 60;
            
            countdownElement.textContent = `(${minutes}:${remainingSeconds.toString().padStart(2, '0')})`;
            
            if (seconds <= 0) {
                clearInterval(countdownInterval);
                countdownElement.textContent = '';
                resendLink.style.pointerEvents = 'auto';
                resendLink.style.opacity = '1';
            } else {
                seconds--;
            }
        }

        updateCountdown();
        countdownInterval = setInterval(updateCountdown, 1000);
    }

    // Helper function to show alerts
    function showAlert(message, type) {
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type === 'error' ? 'danger' : 'success'} alert-dismissible fade show position-fixed`;
        alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        document.body.appendChild(alertDiv);
        
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.parentNode.removeChild(alertDiv);
            }
        }, 5000);
    }
</script>

<style>
.list-group-item.active {
    background-color: #ffc107;
    border-color: #ffc107;
    color: #000;
}

.card {
    transition: transform 0.2s;
}

.card:hover {
    transform: translateY(-2px);
}

.btn {
    transition: all 0.2s;
}

.star-option .form-check-input:checked + .star-label {
    color: #ffc107;
    font-weight: bold;
}
</style>