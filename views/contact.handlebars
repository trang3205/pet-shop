<div class="container py-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active">Liên hệ</li>
        </ol>
    </nav>

    <!-- Page Title -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">
            <i class="bi bi-envelope"></i> Liên hệ với chúng tôi
        </h1>
        <p class="lead text-muted">
            Chúng tôi luôn sẵn lòng lắng nghe ý kiến và trả lời những câu hỏi của bạn
        </p>
    </div>

    <!-- Contact Info Cards -->
    <div class="row mb-5 g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body p-4">
                    <div class="display-5 text-primary mb-3">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-2">Địa chỉ</h5>
                    <p class="card-text text-muted">
                        {{#if shop}}
                            {{#if shop.street_address}}
                                {{shop.street_address}}
                                {{#if shop.ward}}, {{shop.ward}}{{/if}}
                                {{#if shop.district}}, {{shop.district}}{{/if}}
                                {{#if shop.province}}, {{shop.province}}{{/if}}
                            {{else}}
                                Đang cập nhật
                            {{/if}}
                        {{else}}
                            Đang cập nhật
                        {{/if}}
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body p-4">
                    <div class="display-5 text-success mb-3">
                        <i class="bi bi-telephone"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-2">Số điện thoại</h5>
                    <p class="card-text text-muted">
                        {{#if shop}}
                            {{#if shop.phone}}
                                <a href="tel:{{shop.phone}}" class="text-decoration-none text-success fw-bold">{{shop.phone}}</a>
                            {{else}}
                                Đang cập nhật
                            {{/if}}
                        {{else}}
                            Đang cập nhật
                        {{/if}}
                    </p>
                    <p class="small text-muted mt-2">
                        Tư vấn: 8:00 - 22:00 (Hàng ngày)
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body p-4">
                    <div class="display-5 text-info mb-3">
                        <i class="bi bi-envelope"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-2">Email</h5>
                    <p class="card-text text-muted">
                        {{#if shop.email}}
                            <a href="mailto:{{shop.email}}" class="text-decoration-none text-info fw-bold">{{shop.email}}</a>
                        {{else}}
                            <span class="text-muted">Đang cập nhật</span>
                        {{/if}}
                    </p>
                    <p class="small text-muted mt-2">
                        Phản hồi trong vòng 24 giờ
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Map -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="ratio ratio-21x9 bg-light rounded-3 overflow-hidden shadow-sm">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.8314486815556!2d106.68090621533396!3d10.770692192365448!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752e82a5555555%3A0x1111111111111111!2sHo%20Chi%20Minh%20City!5e0!3m2!1sen!2svn!4v1234567890" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>

    <!-- Contact Form & FAQ -->
    <div class="row">
        <!-- Contact Form -->
        <div class="col-lg-7 mb-4 mb-lg-0">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h4 class="card-title fw-bold mb-4">
                        <i class="bi bi-chat-left-text"></i> Gửi tin nhắn cho chúng tôi
                    </h4>
                    <form id="contactForm">
                        <div class="mb-3">
                            <label for="name" class="form-label fw-bold">Họ và tên</label>
                            <input type="text" class="form-control form-control-lg" id="name" name="name" required placeholder="Nhập họ và tên">
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label fw-bold">Email</label>
                            <input type="email" class="form-control form-control-lg" id="email" name="email" required placeholder="Nhập email của bạn">
                        </div>

                        <div class="mb-3">
                            <label for="subject" class="form-label fw-bold">Tiêu đề</label>
                            <select class="form-select form-select-lg" id="subject" name="subject" required>
                                <option value="">-- Chọn tiêu đề --</option>
                                <option value="Hỏi về sản phẩm">Hỏi về sản phẩm</option>
                                <option value="Vấn đề về đơn hàng">Vấn đề về đơn hàng</option>
                                <option value="Góp ý dịch vụ">Góp ý dịch vụ</option>
                                <option value="Hợp tác kinh doanh">Hợp tác kinh doanh</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="message" class="form-label fw-bold">Nội dung tin nhắn</label>
                            <textarea class="form-control" id="message" name="message" rows="5" required placeholder="Nhập nội dung tin nhắn của bạn"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                            <i class="bi bi-send"></i> Gửi tin nhắn
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- FAQ & Social -->
        <div class="col-lg-5">
            <!-- FAQ -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-4">
                        <i class="bi bi-question-circle"></i> Câu hỏi thường gặp
                    </h5>
                    <div class="accordion" id="faqAccordion">
                        <div class="accordion-item border-0 mb-2">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                    Thời gian giao hàng bao lâu?
                                </button>
                            </h2>
                            <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-muted">
                                    Chúng tôi giao hàng trong vòng 1-3 ngày tính từ khi bạn đặt hàng.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item border-0 mb-2">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                    Có miễn phí vận chuyển không?
                                </button>
                            </h2>
                            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-muted">
                                    Có, miễn phí vận chuyển cho đơn hàng từ 500.000đ trở lên.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item border-0 mb-2">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                    Chính sách đổi trả như thế nào?
                                </button>
                            </h2>
                            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-muted">
                                    Bạn có thể đổi trả sản phẩm trong vòng 7 ngày nếu sản phẩm bị lỗi hoặc hỏng hóc.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Social Media -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-4">
                        <i class="bi bi-share"></i> Kết nối với chúng tôi
                    </h5>
                    <div class="d-flex gap-3">
                        <a href="https://facebook.com/petshop" target="_blank" class="btn btn-outline-primary btn-lg rounded-circle flex-shrink-0">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="https://instagram.com/petshop" target="_blank" class="btn btn-outline-danger btn-lg rounded-circle flex-shrink-0">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="https://tiktok.com/petshop" target="_blank" class="btn btn-outline-dark btn-lg rounded-circle flex-shrink-0">
                            <i class="bi bi-tiktok"></i>
                        </a>
                        <a href="https://zalo.me/petshop" target="_blank" class="btn btn-outline-success btn-lg rounded-circle flex-shrink-0">
                            <i class="bi bi-chat-dots"></i>
                        </a>
                    </div>
                    <p class="small text-muted mt-3 mb-0">
                        Follow chúng tôi để nhận các ưu đãi và thông tin mới nhất!
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Alert Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title">
                    <i class="bi bi-check-circle me-2"></i>Gửi thành công!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="successMessage" class="mb-0" style="font-size: 16px; line-height: 1.6;"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">
                    <i class="bi bi-check me-2"></i>Đã hiểu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Error Alert Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-circle me-2"></i>Lỗi!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="errorMessage" class="mb-0" style="font-size: 16px; line-height: 1.6;"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="bi bi-x me-2"></i>Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus,
    .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    .btn-outline-primary:hover,
    .btn-outline-danger:hover,
    .btn-outline-dark:hover,
    .btn-outline-success:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    #contactForm {
        animation: slideIn 0.5s ease;
    }

    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slideInAlert {
        from {
            opacity: 0;
            transform: translateX(400px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes slideOutAlert {
        from {
            opacity: 1;
            transform: translateX(0);
        }
        to {
            opacity: 0;
            transform: translateX(400px);
        }
    }

    .alert.fade.show {
        animation: slideInAlert 0.3s ease !important;
    }

    .alert.fade:not(.show) {
        animation: slideOutAlert 0.3s ease !important;
    }
</style>

<script>
    // Initialize modals - sẽ khởi tạo khi cần
    let successModal = null;
    let errorModal = null;

    document.addEventListener('DOMContentLoaded', function() {
        console.log('✅ DOM Content Loaded');
        
        // Khởi tạo modals
        const successModalEl = document.getElementById('successModal');
        const errorModalEl = document.getElementById('errorModal');
        
        if (successModalEl) {
            successModal = new bootstrap.Modal(successModalEl);
            console.log('✅ Success modal initialized');
        } else {
            console.error('❌ Success modal element not found');
        }
        
        if (errorModalEl) {
            errorModal = new bootstrap.Modal(errorModalEl);
            console.log('✅ Error modal initialized');
        } else {
            console.error('❌ Error modal element not found');
        }

        // Attach form event listener
        const contactForm = document.getElementById('contactForm');
        if (contactForm) {
            console.log('✅ Contact form found, attaching submit handler');
            
            contactForm.addEventListener('submit', handleFormSubmit);
        } else {
            console.error('❌ Contact form not found');
        }
    });

    async function handleFormSubmit(e) {
        e.preventDefault();
        console.log('📝 Form submitted');

        const formData = {
            name: document.getElementById('name').value,
            email: document.getElementById('email').value,
            subject: document.getElementById('subject').value,
            message: document.getElementById('message').value
        };

        console.log('📨 Sending data:', formData);

        try {
            const response = await fetch('/contact', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            console.log('✅ Response received, status:', response.status);

            const data = await response.json();
            console.log('📦 Response data:', data);

            if (data.success) {
                console.log('✅ Success! Showing modal with message:', data.message);
                
                // Show success modal
                if (successModal) {
                    const successMessage = document.getElementById('successMessage');
                    successMessage.textContent = data.message;
                    
                    // Reset form first
                    document.getElementById('contactForm').reset();
                    
                    // Show modal
                    successModal.show();
                    console.log('✅ Modal shown');

                    // Auto-hide after 5 seconds
                    setTimeout(() => {
                        console.log('⏰ Auto-hiding modal');
                        successModal.hide();
                    }, 5000);
                } else {
                    console.error('❌ Success modal not initialized');
                    alert('Gửi thành công!\n' + data.message);
                }
            } else {
                throw new Error(data.message || 'Gửi thất bại');
            }
        } catch (error) {
            console.error('❌ Error caught:', error);
            
            // Show error modal
            if (errorModal) {
                const errorMessage = document.getElementById('errorMessage');
                errorMessage.textContent = error.message || 'Có lỗi xảy ra, vui lòng thử lại!';
                
                // Show modal
                errorModal.show();
                console.log('❌ Error modal shown');

                // Auto-hide after 5 seconds
                setTimeout(() => {
                    console.log('⏰ Auto-hiding error modal');
                    errorModal.hide();
                }, 5000);
            } else {
                console.error('❌ Error modal not initialized');
                alert('Lỗi: ' + (error.message || 'Có lỗi xảy ra!'));
            }
        }
    }
</script>
