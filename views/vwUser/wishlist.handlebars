<!-- views/vwUser/wishlist.handlebars -->
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="bi bi-heart-fill text-danger"></i>
                        Sản phẩm yêu thích
                    </h1>
                    <p class="text-muted mb-0">
                        {{#if wishlistItems.length}}
                        {{totalItems}} sản phẩm trong danh sách yêu thích
                        <span class="badge bg-primary ms-2">Trang
                            {{pagination.currentPage}}/{{pagination.totalPages}}</span>
                        {{else}}
                        Chưa có sản phẩm nào trong danh sách yêu thích
                        {{/if}}
                    </p>
                </div>
                <div>
                    <a href="/categories" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <!-- Wishlist Items Grid -->
            {{#if wishlistItems.length}}
            <div class="row g-4">
                {{#each wishlistItems}}
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card h-100 product-card position-relative border-0 shadow-sm">
                        <!-- Wishlist Remove Button - VERSION IMPROVED -->
                        <div class="position-absolute top-0 end-0 m-2" style="z-index: 10;">
                            <button class="heart-btn" onclick="removeFromWishlist({{this.wishlist_id}})"
                                title="Bỏ yêu thích">
                                <i class="bi bi-heart-fill"></i>
                            </button>
                        </div>

                        <!-- Product Badges -->
                        {{#if this.discount_price}}
                        <span class="badge bg-danger position-absolute top-0 start-0 m-2">Giảm giá</span>
                        {{/if}}
                        {{#if this.is_featured}}
                        <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2"
                            style="transform: translateY(30px);">Nổi bật</span>
                        {{/if}}

                        <!-- Product Image -->
                        <img src="{{this.main_image_url}}" class="card-img-top p-3" alt="{{this.name}}"
                            style="height: 200px; object-fit: contain; cursor: pointer; background: #f8f9fa;"
                            onclick="window.location.href='/products/{{this.id}}'">

                        <div class="card-body d-flex flex-column border-top">
                            <!-- Product Info -->
                            <h6 class="card-title mb-1" style="cursor: pointer;"
                                onclick="window.location.href='/products/{{this.id}}'">
                                {{this.name}}
                            </h6>
                            <small class="text-muted mb-2">{{this.category_name}}</small>

                            <!-- Price -->
                            <div class="mb-2">
                                {{#if this.discount_price}}
                                <div class="d-flex align-items-center">
                                    <strong class="text-danger me-2">{{formatCurrency this.discount_price}}</strong>
                                    <small class="text-muted text-decoration-line-through">
                                        {{formatCurrency this.price}}
                                    </small>
                                </div>
                                {{else}}
                                <strong class="text-primary">{{formatCurrency this.price}}</strong>
                                {{/if}}
                            </div>

                            <!-- Rating & Stock - FIXED VERSION -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                    <small class="text-muted">{{this.average_rating}}</small>
                                    <small class="text-muted ms-1">({{this.review_count}})</small>
                                </div>
                                <div>
                                    <!-- Option 1: Sử dụng nested if blocks -->
                                    {{#ifEqual this.stock_quantity 0}}
                                    <span class="badge bg-danger">Hết hàng</span>
                                    {{else}}
                                    {{#ifLess this.stock_quantity 10}}
                                    <span class="badge bg-warning">Sắp hết</span>
                                    {{else}}
                                    <span class="badge bg-success">Còn hàng</span>
                                    {{/ifLess}}
                                    {{/ifEqual}}
                                </div>
                            </div>

                            <!-- Added Date -->
                            <small class="text-muted mb-3">
                                <i class="bi bi-clock me-1"></i>
                                Thêm: {{formatDate this.added_date}}
                            </small>

                            <!-- Action Buttons -->
                            <div class="mt-auto d-flex gap-2">
                                <button class="btn btn-outline-primary btn-sm flex-grow-1"
                                    onclick="addToCart({{this.id}}, 1)" {{#ifEqual this.stock_quantity
                                    0}}disabled{{/ifEqual}}>
                                    <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                                </button>
                                
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>

            <!-- Pagination -->
            {{#if pagination.showPagination}}
            <div class="mt-5">
                <nav aria-label="Wishlist pagination">
                    <ul class="pagination justify-content-center">
                        {{#if pagination.hasPrevPage}}
                        <li class="page-item">
                            <a class="page-link" href="/user/wishlist?page={{pagination.prevPage}}"
                                aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                        {{else}}
                        <li class="page-item disabled">
                            <span class="page-link">&laquo;</span>
                        </li>
                        {{/if}}

                        {{#each pagination.pages}}
                        <li class="page-item {{#ifEqual this ../pagination.currentPage}}active{{/ifEqual}}">
                            <a class="page-link" href="/user/wishlist?page={{this}}">{{this}}</a>
                        </li>
                        {{/each}}

                        {{#if pagination.hasNextPage}}
                        <li class="page-item">
                            <a class="page-link" href="/user/wishlist?page={{pagination.nextPage}}" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                        {{else}}
                        <li class="page-item disabled">
                            <span class="page-link">&raquo;</span>
                        </li>
                        {{/if}}
                    </ul>
                </nav>
                <div class="text-center text-muted mt-2">
                    <small>Hiển thị {{wishlistItems.length}} sản phẩm trên trang
                        {{pagination.currentPage}}/{{pagination.totalPages}}</small>
                </div>
            </div>
            {{/if}}

            <!-- Empty State -->
            {{else}}
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-heart display-1 text-muted"></i>
                </div>
                <h4 class="text-muted mt-3">Danh sách yêu thích trống</h4>
                <p class="text-muted">Hãy thêm sản phẩm bạn yêu thích vào danh sách này!</p>
                <div class="mt-4">
                    <a href="/categories" class="btn btn-primary me-2">
                        <i class="bi bi-bag"></i> Mua sắm ngay
                    </a>
                    <a href="/" class="btn btn-outline-primary">
                        <i class="bi bi-house"></i> Về trang chủ
                    </a>
                </div>
            </div>
            {{/if}}
        </div>
    </div>
</div>

<script>
    // Function để xóa sản phẩm khỏi wishlist với confirm đẹp hơn
    async function removeFromWishlist(wishlistId) {
        // Tạo custom confirm modal
        const confirmModal = document.createElement('div');
        confirmModal.innerHTML = `
            <div class="modal fade" id="confirmRemoveModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header border-0">
                            <h5 class="modal-title text-danger">
                                <i class="bi bi-heartbreak me-2"></i>Bỏ yêu thích
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body text-center py-4">
                            <i class="bi bi-heartbreak display-1 text-danger mb-3"></i>
                            <h5>Bạn có chắc muốn bỏ yêu thích sản phẩm này?</h5>
                            <p class="text-muted">Sản phẩm sẽ bị xóa khỏi danh sách yêu thích của bạn.</p>
                        </div>
                        <div class="modal-footer border-0 justify-content-center">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-1"></i>Hủy
                            </button>
                            <button type="button" class="btn btn-danger" id="confirmRemoveBtn">
                                <i class="bi bi-trash me-1"></i>Xóa khỏi yêu thích
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;

        document.body.appendChild(confirmModal);

        const modal = new bootstrap.Modal(document.getElementById('confirmRemoveModal'));
        modal.show();

        document.getElementById('confirmRemoveBtn').onclick = async () => {
            modal.hide();

            try {
                const response = await fetch(`/user/wishlist/remove/${wishlistId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const result = await response.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    // Remove item from DOM with animation
                    const itemElement = document.querySelector(`[onclick="removeFromWishlist(${wishlistId})"]`).closest('.col-xl-3');
                    itemElement.style.opacity = '0.5';
                    itemElement.style.transform = 'scale(0.95)';

                    setTimeout(() => {
                        itemElement.remove();

                        // Check if need to update pagination
                        const remainingItems = document.querySelectorAll('.col-xl-3').length;
                        if (remainingItems === 0) {
                            // Reload to update pagination or show empty state
                            setTimeout(() => {
                                window.location.reload();
                            }, 800);
                        }
                    }, 300);
                } else {
                    showToast(result.message || 'Có lỗi xảy ra!', 'error');
                }
            } catch (error) {
                console.error('Error removing from wishlist:', error);
                showToast('Có lỗi xảy ra khi xóa sản phẩm!', 'error');
            }
        };

        // Remove modal from DOM after hidden
        document.getElementById('confirmRemoveModal').addEventListener('hidden.bs.modal', function () {
            this.remove();
        });
    }

    // Function để thêm sản phẩm vào giỏ hàng
    async function addToCart(productId, quantity) {
        try {
            const response = await fetch('/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    product_id: productId,
                    quantity: quantity
                })
            });

            const result = await response.json();

            if (result.success) {
                showToast('Đã thêm sản phẩm vào giỏ hàng!', 'success');
                updateCartCount(result.cartItemsCount);
            } else {
                showToast(result.message || 'Có lỗi xảy ra!', 'error');
            }
        } catch (error) {
            console.error('Error adding to cart:', error);
            showToast('Có lỗi xảy ra khi thêm vào giỏ hàng!', 'error');
        }
    }

    // Toast notification
    function showToast(message, type = 'info') {
        const toastContainer = document.getElementById('toast-container') || createToastContainer();

        const toastId = 'toast-' + Date.now();
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-bg-${type === 'error' ? 'danger' : type} border-0`;
        toast.id = toastId;
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi ${type === 'success' ? 'bi-check-circle' : 'bi-exclamation-circle'} me-2"></i>
                    ${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        `;

        toastContainer.appendChild(toast);
        const bsToast = new bootstrap.Toast(toast, { delay: 3000 });
        bsToast.show();

        toast.addEventListener('hidden.bs.toast', () => {
            toast.remove();
        });
    }

    function createToastContainer() {
        const container = document.createElement('div');
        container.id = 'toast-container';
        container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
        container.style.zIndex = '9999';
        document.body.appendChild(container);
        return container;
    }

    function updateCartCount(count) {
        const cartBadge = document.querySelector('.cart-badge');
        if (cartBadge) {
            cartBadge.textContent = count;
            cartBadge.classList.add('cart-badge-pulse');
            setTimeout(() => {
                cartBadge.classList.remove('cart-badge-pulse');
            }, 500);
        }
    }
</script>

<style>
    /* Heart button styles */
    .heart-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        border: 2px solid #dc3545;
        background-color: white;
        cursor: pointer;
    }

    .heart-btn:hover {
        background-color: #dc3545;
        transform: scale(1.1);
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
    }

    .heart-btn i {
        color: #dc3545;
        font-size: 18px;
        transition: color 0.3s;
    }

    .heart-btn:hover i {
        color: white;
    }

    /* Product card hover effect */
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
    }

    /* Cart badge animation */
    .cart-badge-pulse {
        animation: pulse 0.5s ease-in-out;
    }

    @keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1);
        }
    }

    /* Pagination styles */
    .pagination .page-item.active .page-link {
        background-color: #f7f5f5;
        border-color: #dc3545;
    }

    .pagination .page-link {
        color: #dc3545;
        border: 1px solid #dee2e6;
    }

    .pagination .page-link:hover {
        background-color: #f8f9fa;
        color: #dc3545;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        .heart-btn {
            width: 36px;
            height: 36px;
        }

        .heart-btn i {
            font-size: 16px;
        }

        .product-card .btn-sm {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }
    }
</style>