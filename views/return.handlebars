            <li class="breadcrumb-item active">Chính sách đổi trả</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">
            <i class="bi bi-arrow-repeat"></i> Chính sách đổi trả
