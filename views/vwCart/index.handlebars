<!-- views/vwCart/index.handlebars - CẬP NHẬT VỚI CHECKBOX -->
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="h2 mb-4">🛒 Giỏ hàng của bạn</h1>
        </div>
    </div>

    {{#if error}}
    <div class="alert alert-danger">
        {{error}}
    </div>
    {{/if}}

    <div class="row">
        <!-- Cart Items -->
        <div class="col-lg-8">
            {{#if allItems.length}}
            <div class="card">
                <div class="card-header bg-light">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="selectAll">
                        <label class="form-check-label fw-bold" for="selectAll">
                            Chọn tất cả ({{allItems.length}} sản phẩm)
                        </label>
                    </div>
                </div>
                <div class="card-body">
                    {{#each allItems}}
                    <div class="cart-item border-bottom pb-3 mb-3" data-product-id="{{this.product_id}}">
                        <div class="row align-items-center">
                            <div class="col-md-1">
                                <div class="form-check">
                                    <input class="form-check-input product-checkbox" type="checkbox"
                                        value="{{this.product_id}}" id="product-{{this.product_id}}">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <img src="{{this.main_image_url}}" alt="{{this.name}}" class="img-fluid rounded"
                                    style="height: 80px; object-fit: cover;"
                                    onerror="this.src='/static/imgs/products/default-product.jpg'">
                            </div>
                            <div class="col-md-3">
                                <h6 class="mb-1">{{this.name}}</h6>
                                <small class="text-muted">SKU: {{this.sku}}</small>
                                {{#unless this.is_active}}
                                <div class="text-danger small">Sản phẩm không khả dụng</div>
                                {{/unless}}
                            </div>
                            <div class="col-md-2">
                                <div class="price">
                                    {{#if this.discount_price}}
                                    <div class="text-danger fw-bold">{{formatCurrency this.discount_price}}</div>
                                    <small class="text-muted text-decoration-line-through">{{formatCurrency
                                        this.price}}</small>
                                    {{else}}
                                    <div class="text-primary fw-bold">{{formatCurrency this.price}}</div>
                                    {{/if}}
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="input-group input-group-sm">
                                    <button class="btn btn-outline-secondary decrease-btn" type="button">-</button>
                                    <input type="number" class="form-control text-center quantity-input"
                                        value="{{this.quantity}}" min="1" max="{{this.stock_quantity}}"
                                        data-product-id="{{this.product_id}}">
                                    <button class="btn btn-outline-secondary increase-btn" type="button">+</button>
                                </div>
                                <small class="text-muted d-block mt-1">Còn: {{this.stock_quantity}} sp</small>
                            </div>
                            <div class="col-md-2">
                                <div class="text-end">
                                    <div class="fw-bold mb-2 item-total" data-product-id="{{this.product_id}}">
                                        {{formatCurrency (multiply (default this.discount_price this.price)
                                        this.quantity)}}
                                    </div>
                                    <button class="btn btn-outline-danger btn-sm remove-btn"
                                        data-product-id="{{this.product_id}}">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{else}}
            <div class="card text-center py-5">
                <div class="card-body">
                    <i class="bi bi-cart-x display-1 text-muted"></i>
                    <h3 class="mt-3">Giỏ hàng trống</h3>
                    <p class="text-muted">Bạn chưa có sản phẩm nào trong giỏ hàng</p>
                    <a href="/" class="btn btn-primary">Tiếp tục mua sắm</a>
                </div>
            </div>
            {{/if}}
        </div>

        <!-- Cart Summary -->
        {{#if allItems.length}}
        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 100px;">
                <div class="card-body">
                    <h5 class="card-title">Tổng đơn hàng</h5>

                    <div class="selected-items-info mb-3">
                        <small class="text-muted selected-count">Đã chọn 0 sản phẩm</small>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="items-count">Tạm tính:</span>
                        <span class="fw-bold subtotal-amount">{{formatCurrency 0}}</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí vận chuyển:</span>
                        <span class="text-success">Miễn phí</span>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="h5">Tổng cộng:</span>
                        <span class="h5 text-danger total-amount">{{formatCurrency 0}}</span>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-danger btn-lg checkout-btn" disabled>
                            <i class="bi bi-credit-card"></i> Thanh toán
                        </button>
                        <a href="/" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}
    </div>
</div>

<script>
    function getCSRFToken() {
        return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    }
    document.addEventListener('DOMContentLoaded', function () {
        console.log('🛒 CART PAGE WITH SELECTION LOADED');
        let selectedProducts = [];

        // ======================
        // SELECTION FUNCTIONALITY
        // ======================
        const selectAllCheckbox = document.getElementById('selectAll');
        const productCheckboxes = document.querySelectorAll('.product-checkbox');
        const checkoutBtn = document.querySelector('.checkout-btn');

        // Select All functionality
        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener('change', function () {
                const isChecked = this.checked;
                productCheckboxes.forEach(checkbox => {
                    checkbox.checked = isChecked;
                });
                updateSelectedProducts();
            });
        }

        // Individual checkbox change
        productCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', updateSelectedProducts);
        });

        function updateSelectedProducts() {
            selectedProducts = [];
            let totalSelected = 0;

            productCheckboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    selectedProducts.push(checkbox.value);
                    totalSelected++;
                }
            });

            // Update select all checkbox
            if (selectAllCheckbox) {
                selectAllCheckbox.checked = totalSelected === productCheckboxes.length;
                selectAllCheckbox.indeterminate = totalSelected > 0 && totalSelected < productCheckboxes.length;
            }

            // Update UI
            updateSelectedCount(totalSelected);
            calculateSelectedTotal();
            updateCheckoutButton(totalSelected);
        }

        function updateSelectedCount(count) {
            const selectedCountElement = document.querySelector('.selected-count');
            if (selectedCountElement) {
                selectedCountElement.textContent = `Đã chọn ${count} sản phẩm`;
            }
        }

        function updateCheckoutButton(selectedCount) {
            if (checkoutBtn) {
                if (selectedCount > 0) {
                    checkoutBtn.disabled = false;
                    checkoutBtn.textContent = `Thanh toán (${selectedCount} sản phẩm)`;
                } else {
                    checkoutBtn.disabled = true;
                    checkoutBtn.textContent = 'Thanh toán';
                }
            }
        }

        async function calculateSelectedTotal() {
            if (selectedProducts.length === 0) {
                updateTotalDisplay(0, 0);
                return;
            }

            try {
                const response = await fetch('/cart/selected-total', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': getCSRFToken() // ✅ THÊM DÒNG NÀY
                    },
                    body: JSON.stringify({
                        selected_products: selectedProducts
                    })
                });

                const result = await response.json();

                if (result.success) {
                    updateTotalDisplay(result.subtotal, result.totalItems);
                } else {
                    console.error('Error calculating selected total:', result.message);
                    updateTotalDisplay(0, 0);
                }
            } catch (error) {
                console.error('Error calculating selected total:', error);
                updateTotalDisplay(0, 0);
            }
        }

        function updateTotalDisplay(subtotal, totalItems) {
            const subtotalElement = document.querySelector('.subtotal-amount');
            const totalElement = document.querySelector('.total-amount');
            const itemsCountElement = document.querySelector('.items-count');

            if (subtotalElement && totalElement && itemsCountElement) {
                subtotalElement.textContent = formatCurrency(subtotal);
                totalElement.textContent = formatCurrency(subtotal);
                itemsCountElement.textContent = `Tạm tính (${totalItems} sản phẩm):`;
            }
        }

        // Checkout button click
        if (checkoutBtn) {
            checkoutBtn.addEventListener('click', function () {
                if (selectedProducts.length > 0) {
                    sessionStorage.setItem('selectedCartItems', JSON.stringify(selectedProducts));
                    window.location.href = '/checkout?selected=' + selectedProducts.join(',');
                }
            });
        }

        // ======================
        // QUANTITY & REMOVE FUNCTIONS
        // ======================

        // Update quantity functions
        document.querySelectorAll('.quantity-input').forEach(input => {
            const productId = input.dataset.productId;
            console.log('🔧 SETUP QUANTITY INPUT FOR PRODUCT:', productId);

            // Decrease button
            input.closest('.input-group').querySelector('.decrease-btn').addEventListener('click', () => {
                const currentValue = parseInt(input.value);
                if (currentValue > 1) {
                    updateQuantity(productId, currentValue - 1);
                }
            });

            // Increase button
            input.closest('.input-group').querySelector('.increase-btn').addEventListener('click', () => {
                const currentValue = parseInt(input.value);
                const maxStock = parseInt(input.getAttribute('max'));
                if (currentValue < maxStock) {
                    updateQuantity(productId, currentValue + 1);
                } else {
                    showAlert(`Chỉ còn ${maxStock} sản phẩm trong kho`, 'warning');
                }
            });

            // Input change
            input.addEventListener('change', function () {
                let value = parseInt(this.value);
                const min = parseInt(this.getAttribute('min'));
                const max = parseInt(this.getAttribute('max'));

                if (isNaN(value) || value < min) value = min;
                if (value > max) {
                    value = max;
                    showAlert(`Chỉ còn ${max} sản phẩm trong kho`, 'warning');
                }

                this.value = value;
                updateQuantity(productId, value);
            });
        });

        // Remove item functions
        document.querySelectorAll('.remove-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const productId = this.dataset.productId;
                console.log('🗑️ REMOVE BUTTON CLICKED FOR PRODUCT:', productId);
                removeFromCart(productId);
            });
        });

        async function updateQuantity(productId, quantity) {
            console.log('🔄 UPDATING QUANTITY - Product:', productId, 'New Qty:', quantity);

            try {
                const response = await fetch('/cart/update', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': getCSRFToken() // ✅ THÊM DÒNG NÀY
                    },
                    body: JSON.stringify({
                        product_id: parseInt(productId),
                        quantity: parseInt(quantity)
                    })
                });

                const result = await response.json();
                console.log('📦 UPDATE RESPONSE:', result);

                if (result.success) {
                    showAlert(result.message, 'success');

                    // Update cart count in navbar
                    updateCartCount(result.totalItems);

                    // Update the specific item total
                    const itemTotalElement = document.querySelector(`.item-total[data-product-id="${productId}"]`);
                    if (itemTotalElement && result.items) {
                        const updatedItem = result.items.find(item => item.product_id == productId);
                        if (updatedItem) {
                            const price = updatedItem.discount_price || updatedItem.price;
                            const total = price * updatedItem.quantity;
                            itemTotalElement.textContent = formatCurrency(total);
                        }
                    }

                    // Update input value
                    const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`);
                    if (input) {
                        input.value = quantity;
                    }

                    // Recalculate selected total if this product is selected
                    if (selectedProducts.includes(productId.toString())) {
                        calculateSelectedTotal();
                    }
                } else {
                    showAlert(result.message, 'error');
                    // Reload to sync with server
                    setTimeout(() => location.reload(), 1000);
                }
            } catch (error) {
                console.error('❌ Error updating quantity:', error);
                showAlert('Có lỗi xảy ra khi cập nhật số lượng', 'error');
            }
        }

        async function removeFromCart(productId) {
            console.log('🗑️ REMOVING FROM CART - Product:', productId);

            if (!confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?')) {
                return;
            }

            try {
                const response = await fetch('/cart/remove', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': getCSRFToken() // ✅ THÊM DÒNG NÀY
                    },
                    body: JSON.stringify({
                        product_id: parseInt(productId)
                    })
                });

                const result = await response.json();
                console.log('📦 REMOVE RESPONSE:', result);

                if (result.success) {
                    showAlert(result.message, 'success');

                    // Remove item from DOM
                    const itemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                    if (itemElement) {
                        itemElement.remove();
                    }

                    // Remove from selected products if it was selected
                    const index = selectedProducts.indexOf(productId.toString());
                    if (index > -1) {
                        selectedProducts.splice(index, 1);
                        updateSelectedProducts();
                    }

                    // Update cart count
                    updateCartCount(result.totalItems);

                    // Check if cart is empty
                    if (result.totalItems === 0) {
                        setTimeout(() => location.reload(), 500);
                    }
                } else {
                    showAlert(result.message, 'error');
                }
            } catch (error) {
                console.error('❌ Error removing from cart:', error);
                showAlert('Có lỗi xảy ra khi xóa sản phẩm', 'error');
            }
        }

        // ======================
        // UTILITY FUNCTIONS
        // ======================

        function showAlert(message, type) {
            console.log('📢 ALERT:', type, message);

            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type === 'error' ? 'danger' : type === 'warning' ? 'warning' : 'success'} alert-dismissible fade show position-fixed`;
            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';

            // ✅ FIX: Sử dụng textContent thay vì innerHTML
            const messageSpan = document.createElement('span');
            messageSpan.textContent = message;
            alertDiv.appendChild(messageSpan);

            // ✅ FIX: Tạo button close an toàn
            const closeBtn = document.createElement('button');
            closeBtn.type = 'button';
            closeBtn.className = 'btn-close';
            closeBtn.setAttribute('data-bs-dismiss', 'alert');
            closeBtn.setAttribute('aria-label', 'Close');
            alertDiv.appendChild(closeBtn);

            document.body.appendChild(alertDiv);

            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 4000);
        }

        function updateCartCount(count) {
            console.log('🔄 UPDATING CART COUNT:', count);
            const cartBadge = document.querySelector('.cart-badge');
            if (cartBadge) {
                cartBadge.textContent = count;
            }
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);
        }
    });
</script>