<!-- views/vwCart/index.handlebars - CẬP NHẬT VỚI CHECKBOX -->
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="h2 mb-4">🛒 Giỏ hàng của bạn</h1>
        </div>
    </div>

    {{#if error}}
    <div class="alert alert-danger">
        {{error}}
    </div>
    {{/if}}

    <div class="row">
        <!-- Cart Items -->
        <div class="col-lg-8">
            {{#if allItems.length}}
            <div class="card">
                <div class="card-header bg-light">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="selectAll">
                        <label class="form-check-label fw-bold" for="selectAll">
                            Chọn tất cả ({{allItems.length}} sản phẩm)
                        </label>
                    </div>
                </div>
                <div class="card-body">
                    {{#each allItems}}
                    <div class="cart-item border-bottom pb-3 mb-3" data-product-id="{{this.product_id}}">
                        <div class="row align-items-center">
                            <div class="col-md-1">
                                <div class="form-check">
                                    <input class="form-check-input product-checkbox" type="checkbox" 
                                           value="{{this.product_id}}" 
                                           id="product-{{this.product_id}}"
                                           data-price="{{default this.discount_price this.price}}"
                                           data-quantity="{{this.quantity}}">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <img src="{{this.main_image_url}}" alt="{{this.name}}" 
                                     class="img-fluid rounded" style="height: 80px; object-fit: cover;"
                                     onerror="this.src='/static/imgs/products/default-product.jpg'">
                            </div>
                            <div class="col-md-3">
                                <h6 class="mb-1">{{this.name}}</h6>
                                <small class="text-muted">SKU: {{this.sku}}</small>
                                {{#unless this.is_active}}
                                <div class="text-danger small">Sản phẩm không khả dụng</div>
                                {{/unless}}
                            </div>
                            <div class="col-md-2">
                                <div class="price">
                                    {{#if this.discount_price}}
                                    <div class="text-danger fw-bold">{{formatCurrency this.discount_price}}</div>
                                    <small class="text-muted text-decoration-line-through">{{formatCurrency this.price}}</small>
                                    {{else}}
                                    <div class="text-primary fw-bold">{{formatCurrency this.price}}</div>
                                    {{/if}}
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="input-group input-group-sm">
                                    <button class="btn btn-outline-secondary decrease-btn" type="button">-</button>
                                    <input type="number" class="form-control text-center quantity-input" 
                                           value="{{this.quantity}}" min="1" max="{{this.stock_quantity}}"
                                           data-product-id="{{this.product_id}}">
                                    <button class="btn btn-outline-secondary increase-btn" type="button">+</button>
                                </div>
                                <small class="text-muted d-block mt-1">Còn: {{this.stock_quantity}} sp</small>
                            </div>
                            <div class="col-md-2">
                                <div class="text-end">
                                    <div class="fw-bold mb-2 item-total" data-product-id="{{this.product_id}}">
                                        {{formatCurrency (multiply (default this.discount_price this.price) this.quantity)}}
                                    </div>
                                    <button class="btn btn-outline-danger btn-sm remove-btn" 
                                            data-product-id="{{this.product_id}}">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{else}}
            <div class="card text-center py-5">
                <div class="card-body">
                    <i class="bi bi-cart-x display-1 text-muted"></i>
                    <h3 class="mt-3">Giỏ hàng trống</h3>
                    <p class="text-muted">Bạn chưa có sản phẩm nào trong giỏ hàng</p>
                    <a href="/" class="btn btn-primary">Tiếp tục mua sắm</a>
                </div>
            </div>
            {{/if}}
        </div>

        <!-- Cart Summary -->
        {{#if allItems.length}}
        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 100px;">
                <div class="card-body">
                    <h5 class="card-title">Tổng đơn hàng</h5>
                    
                    <div class="selected-items-info mb-3">
                        <small class="text-muted selected-count">Đã chọn 0 sản phẩm</small>
                    </div>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="items-count">Tạm tính:</span>
                        <span class="fw-bold subtotal-amount">{{formatCurrency 0}}</span>
                    </div>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí vận chuyển:</span>
                        <span class="text-success">Miễn phí</span>
                    </div>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between mb-3">
                        <span class="h5">Tổng cộng:</span>
                        <span class="h5 text-danger total-amount">{{formatCurrency 0}}</span>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-danger btn-lg checkout-btn" disabled>
                            <i class="bi bi-credit-card"></i> Thanh toán
                        </button>
                        <a href="/" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('🛒 CART PAGE WITH SELECTION LOADED');
    let selectedProducts = [];

    // Select All functionality
    const selectAllCheckbox = document.getElementById('selectAll');
    const productCheckboxes = document.querySelectorAll('.product-checkbox');
    const checkoutBtn = document.querySelector('.checkout-btn');

    if (selectAllCheckbox) {
        selectAllCheckbox.addEventListener('change', function() {
            const isChecked = this.checked;
            productCheckboxes.forEach(checkbox => {
                checkbox.checked = isChecked;
            });
            updateSelectedProducts();
        });
    }

    // Individual checkbox change
    productCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateSelectedProducts);
    });

    function updateSelectedProducts() {
        selectedProducts = [];
        let totalSelected = 0;

        productCheckboxes.forEach(checkbox => {
            if (checkbox.checked) {
                selectedProducts.push(checkbox.value);
                totalSelected++;
            }
        });

        // Update select all checkbox
        if (selectAllCheckbox) {
            selectAllCheckbox.checked = totalSelected === productCheckboxes.length;
            selectAllCheckbox.indeterminate = totalSelected > 0 && totalSelected < productCheckboxes.length;
        }

        // Update UI
        updateSelectedCount(totalSelected);
        calculateSelectedTotal();
        updateCheckoutButton(totalSelected);
    }

    function updateSelectedCount(count) {
        const selectedCountElement = document.querySelector('.selected-count');
        if (selectedCountElement) {
            selectedCountElement.textContent = `Đã chọn ${count} sản phẩm`;
        }
    }

    function updateCheckoutButton(selectedCount) {
        if (checkoutBtn) {
            if (selectedCount > 0) {
                checkoutBtn.disabled = false;
                checkoutBtn.textContent = `Thanh toán (${selectedCount} sản phẩm)`;
            } else {
                checkoutBtn.disabled = true;
                checkoutBtn.textContent = 'Thanh toán';
            }
        }
    }

    async function calculateSelectedTotal() {
        if (selectedProducts.length === 0) {
            updateTotalDisplay(0, 0);
            return;
        }

        try {
            const response = await fetch('/cart/selected-total', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    selected_products: selectedProducts
                })
            });

            const result = await response.json();

            if (result.success) {
                updateTotalDisplay(result.subtotal, result.totalItems);
            } else {
                console.error('Error calculating selected total:', result.message);
                updateTotalDisplay(0, 0);
            }
        } catch (error) {
            console.error('Error calculating selected total:', error);
            updateTotalDisplay(0, 0);
        }
    }

    function updateTotalDisplay(subtotal, totalItems) {
        const subtotalElement = document.querySelector('.subtotal-amount');
        const totalElement = document.querySelector('.total-amount');
        const itemsCountElement = document.querySelector('.items-count');

        if (subtotalElement && totalElement && itemsCountElement) {
            subtotalElement.textContent = formatCurrency(subtotal);
            totalElement.textContent = formatCurrency(subtotal);
            itemsCountElement.textContent = `Tạm tính (${totalItems} sản phẩm):`;
        }
    }

    // Checkout button click
    if (checkoutBtn) {
        checkoutBtn.addEventListener('click', function() {
            if (selectedProducts.length > 0) {
                // Lưu selected products vào session hoặc chuyển đến checkout
                sessionStorage.setItem('selectedCartItems', JSON.stringify(selectedProducts));
                window.location.href = '/checkout?selected=' + selectedProducts.join(',');
            }
        });
    }

    // Các hàm cũ giữ nguyên (updateQuantity, removeFromCart, etc.)
    // ... (giữ nguyên tất cả code JavaScript cũ)

    // Format currency function
    function formatCurrency(amount) {
        return new Intl.NumberFormat('vi-VN', {
            style: 'currency',
            currency: 'VND'
        }).format(amount);
    }

    // Show alert function
    function showAlert(message, type) {
        // ... (giữ nguyên)
    }

    // Update cart count function
    function updateCartCount(count) {
        // ... (giữ nguyên)
    }
});
</script>