{{! 📁 views/vwCheckout/confirmation.handlebars }}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card text-center">
                <div class="card-body py-5">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h1 class="card-title mb-3">Đặt hàng thành công!</h1>
                    <p class="card-text mb-4">
                        Cảm ơn bạn đã đặt hàng. Đơn hàng của bạn đã được tiếp nhận và đang được xử lý.
                    </p>
                    
                    <div class="bg-light p-4 rounded mb-4 text-start">
                        <h5 class="mb-3">Thông tin đơn hàng</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Mã đơn hàng:</strong><br>{{order.order_number}}</p>
                                <p><strong>Ngày đặt:</strong><br>{{formatDate order.created_at}}</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Phương thức thanh toán:</strong><br>
                                    {{#ifEqual order.payment_method 'cod'}}
                                    Thanh toán khi nhận hàng
                                    {{else}}
                                    Chuyển khoản ngân hàng
                                    {{/ifEqual}}
                                </p>
                                <p><strong>Tổng tiền:</strong><br>
                                    <span class="text-danger fw-bold">{{formatCurrency order.total_amount}}</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-center">
                        <a href="/" class="btn btn-outline-primary me-md-2">
                            Tiếp tục mua sắm
                        </a>
                        <a href="/account/orders" class="btn btn-primary">
                            Xem đơn hàng của tôi
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>