<!-- Shop Settings -->
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {{> adminSidebar}}

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Shop Settings</h1>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div id="successAlert" class="alert alert-success alert-dismissible fade d-none" role="alert">
                        <i class="bi bi-check-circle"></i> Shop settings updated successfully!
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <div id="errorAlert" class="alert alert-danger alert-dismissible fade d-none" role="alert">
                        <i class="bi bi-exclamation-circle"></i> <span id="errorMessage"></span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <div class="card shadow">
                        <div class="card-body">
                            <form id="shopSettingsForm">
                                <div class="mb-3">
                                    <label class="form-label">Shop Name</label>
                                    <input type="text" name="name" class="form-control" value="{{shop.name}}" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Phone</label>
                                    <input type="text" name="phone" class="form-control" value="{{shop.phone}}">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Street Address</label>
                                    <input type="text" name="street_address" class="form-control" value="{{shop.street_address}}">
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Province</label>
                                            <input type="text" name="province" class="form-control" value="{{shop.province}}">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">District</label>
                                            <input type="text" name="district" class="form-control" value="{{shop.district}}">
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Ward</label>
                                    <input type="text" name="ward" class="form-control" value="{{shop.ward}}">
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-save"></i> Save Settings
                                    </button>
                                    <a href="/admin/dashboard" class="btn btn-secondary">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<script>
document.getElementById('shopSettingsForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(document.getElementById('shopSettingsForm'));
    const data = Object.fromEntries(formData);

    try {
        const response = await fetch('/admin/shop-settings/update', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        });

        const result = await response.json();
        
        if (result.success) {
            document.getElementById('successAlert').classList.remove('d-none');
            setTimeout(() => {
                document.getElementById('successAlert').classList.add('d-none');
                window.location.reload();
            }, 1500);
        } else {
            document.getElementById('errorMessage').textContent = result.message;
            document.getElementById('errorAlert').classList.remove('d-none');
        }
    } catch (error) {
        console.error('Error:', error);
        document.getElementById('errorMessage').textContent = 'Failed to update shop settings';
        document.getElementById('errorAlert').classList.remove('d-none');
    }
});
</script>
