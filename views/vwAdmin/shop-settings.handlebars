<!-- Shop Settings -->
<div class="container-fluid">
    <div class="row">
        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Shop Settings</h1>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="card shadow">
                        <div class="card-body">
                            <form id="shopSettingsForm">
                                <div class="mb-3">
                                    <label class="form-label">Shop Name</label>
                                    <input type="text" name="name" class="form-control" value="{{shop.name}}" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Phone</label>
                                    <input type="text" name="phone" class="form-control" value="{{shop.phone}}">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="email" name="email" class="form-control" value="{{shop.email}}">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Street Address</label>
                                    <input type="text" name="street_address" class="form-control" value="{{shop.street_address}}">
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Province</label>
                                            <input type="text" name="province" class="form-control" value="{{shop.province}}">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">District</label>
                                            <input type="text" name="district" class="form-control" value="{{shop.district}}">
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Ward</label>
                                    <input type="text" name="ward" class="form-control" value="{{shop.ward}}">
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-save"></i> Save Settings
                                    </button>
                                    <a href="/admin/dashboard" class="btn btn-secondary">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title">
                    <i class="bi bi-check-circle me-2"></i>Cập nhật thành công!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="successMessage" class="mb-0" style="font-size: 16px; line-height: 1.6;">Cài đặt cửa hàng đã được cập nhật thành công.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">
                    <i class="bi bi-check me-2"></i>Đã hiểu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-circle me-2"></i>Lỗi!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="errorMessage" class="mb-0" style="font-size: 16px; line-height: 1.6;"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="bi bi-x me-2"></i>Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Initialize modals
    let successModal = null;
    let errorModal = null;

    document.addEventListener('DOMContentLoaded', function() {
        console.log('✅ DOM loaded - initializing shop settings');
        
        const successModalEl = document.getElementById('successModal');
        const errorModalEl = document.getElementById('errorModal');
        
        if (successModalEl) {
            successModal = new bootstrap.Modal(successModalEl);
            console.log('✅ Success modal initialized');
        }
        
        if (errorModalEl) {
            errorModal = new bootstrap.Modal(errorModalEl);
            console.log('✅ Error modal initialized');
        }

        // Attach form event listener
        const form = document.getElementById('shopSettingsForm');
        if (form) {
            console.log('✅ Shop settings form found, attaching handler');
            form.addEventListener('submit', handleFormSubmit);
        }
    });

    async function handleFormSubmit(e) {
        e.preventDefault();
        console.log('📝 Shop settings form submitted');

        const formData = new FormData(document.getElementById('shopSettingsForm'));
        const data = Object.fromEntries(formData);

        console.log('📨 Sending data:', data);

        try {
            const response = await fetch('/admin/shop-settings/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            console.log('✅ Response received, status:', response.status);

            const result = await response.json();
            console.log('📦 Response data:', result);
            
            if (result.success) {
                console.log('✅ Settings updated successfully');
                
                if (successModal) {
                    const successMsg = document.getElementById('successMessage');
                    successMsg.textContent = result.message || 'Cài đặt cửa hàng đã được cập nhật thành công.';
                    
                    successModal.show();
                    console.log('✅ Success modal shown');

                    // Auto-reload after 2 seconds
                    setTimeout(() => {
                        console.log('🔄 Reloading page');
                        window.location.reload();
                    }, 2000);
                } else {
                    alert(result.message || 'Settings updated successfully!');
                    window.location.reload();
                }
            } else {
                throw new Error(result.message || 'Update failed');
            }
        } catch (error) {
            console.error('❌ Error:', error);
            
            if (errorModal) {
                const errorMsg = document.getElementById('errorMessage');
                errorMsg.textContent = error.message || 'Có lỗi xảy ra, vui lòng thử lại!';
                
                errorModal.show();
                console.log('❌ Error modal shown');
            } else {
                alert('Error: ' + (error.message || 'Failed to update settings'));
            }
        }
    }
</script>
