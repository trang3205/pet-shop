<!-- Managers Management -->
<div class="container-fluid">
    <div class="row">
        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Managers Management</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addManagerModal">
                        <i class="bi bi-plus"></i>
                        Add New Manager
                    </button>
                </div>
            </div>

            <!-- Search -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" class="form-control" id="searchInput" placeholder="Search by name or email...">
                        <button class="btn btn-outline-secondary" type="button" id="searchBtn">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="roleFilter">
                        <option value="" selected>Show All</option>
                        <option value="admin">Admin</option>
                        <option value="manager">Manager</option>
                    </select>
                </div>
            </div>

            <!-- Admins Table -->
            <h3 class="mt-5 mb-3" id="adminSectionTitle">Administrators</h3>
            <div class="table-responsive" id="adminTableContainer">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="adminTableBody">
                        {{#each admins}}
                        <tr class="admin-row" data-name="{{this.name}}" data-email="{{this.email}}" data-role="{{this.role}}">
                            <td>{{this.id}}</td>
                            <td>{{this.name}}</td>
                            <td>{{this.email}}</td>
                            <td><span class="badge bg-warning">Admin</span></td>
                            <td><span class="badge {{#if this.is_locked}}bg-danger{{else}}bg-success{{/if}}">{{#if this.is_locked}}Locked{{else}}Active{{/if}}</span></td>
                            <td>{{this.created_at}}</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-info me-1" data-bs-toggle="modal" data-bs-target="#editManagerModal" data-id="{{this.id}}" data-name="{{this.name}}" data-email="{{this.email}}" data-phone="{{this.phone}}" data-role="{{this.role}}"><i class="bi bi-pencil"></i></a>
                                <a href="#" class="btn btn-sm btn-danger" data-id="{{this.id}}"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            {{#unless admins}}
            <div class="alert alert-info" id="adminEmptyMsg">
                <i class="bi bi-info-circle"></i>
                No admins found.
            </div>
            {{/unless}}

            <!-- Managers Table -->
            <h3 class="mt-5 mb-3" id="managerSectionTitle">Managers</h3>
            <div class="table-responsive" id="managerTableContainer">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="managerTableBody">
                        {{#each managers}}
                        <tr class="manager-row" data-name="{{this.name}}" data-email="{{this.email}}" data-role="{{this.role}}">
                            <td>{{this.id}}</td>
                            <td>{{this.name}}</td>
                            <td>{{this.email}}</td>
                            <td><span class="badge bg-info">Manager</span></td>
                            <td><span class="badge {{#if this.is_locked}}bg-danger{{else}}bg-success{{/if}}">{{#if this.is_locked}}Locked{{else}}Active{{/if}}</span></td>
                            <td>{{this.created_at}}</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-info me-1" data-bs-toggle="modal" data-bs-target="#editManagerModal" data-id="{{this.id}}" data-name="{{this.name}}" data-email="{{this.email}}" data-phone="{{this.phone}}" data-role="{{this.role}}"><i class="bi bi-pencil"></i></a>
                                <a href="#" class="btn btn-sm btn-danger" data-id="{{this.id}}"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            {{#unless managers}}
            <div class="alert alert-info" id="managerEmptyMsg">
                <i class="bi bi-info-circle"></i>
                No managers found.
            </div>
            {{/unless}}

            <!-- Pagination -->
            {{#if totalPages}}
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <!-- Previous Button -->
                    <li class="page-item {{#if (eq currentPage 1)}}disabled{{/if}}">
                        {{#if (gt currentPage 1)}}
                            <a class="page-link" href="/admin/managers?page={{subtract currentPage 1}}">Previous</a>
                        {{else}}
                            <a class="page-link" href="#" tabindex="-1">Previous</a>
                        {{/if}}
                    </li>

                    <!-- Page Numbers -->
                    {{#each (arrayRange totalPages)}}
                        <li class="page-item {{#if (eq this ../currentPage)}}active{{/if}}">
                            <a class="page-link" href="/admin/managers?page={{this}}">{{this}}</a>
                        </li>
                    {{/each}}

                    <!-- Next Button -->
                    <li class="page-item {{#if (eq currentPage totalPages)}}disabled{{/if}}">
                        {{#if (lt currentPage totalPages)}}
                            <a class="page-link" href="/admin/managers?page={{add currentPage 1}}">Next</a>
                        {{else}}
                            <a class="page-link" href="#">Next</a>
                        {{/if}}
                    </li>
                </ul>
            </nav>
            {{/if}}
        </main>
    </div>
</div>

<!-- Add New Manager Modal -->
<div class="modal fade" id="addManagerModal" tabindex="-1" aria-labelledby="addManagerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addManagerModalLabel">Add New Manager</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addManagerForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="addName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="addName" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="addEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="addEmail" name="email" required>
                    </div>
                    <div class="mb-3">
                        <label for="addPhone" class="form-label">Phone</label>
                        <input type="text" class="form-control" id="addPhone" name="phone">
                    </div>
                    <div class="mb-3">
                        <label for="addPassword" class="form-label">Password</label>
                        <input type="password" class="form-control" id="addPassword" name="password" required>
                    </div>
                    <div class="mb-3">
                        <label for="addRole" class="form-label">Role</label>
                        <select class="form-select" id="addRole" name="role" required>
                            <option value="">-- Select Role --</option>
                            <option value="admin">Admin</option>
                            <option value="manager">Manager</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Add Manager</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Manager Modal -->
<div class="modal fade" id="editManagerModal" tabindex="-1" aria-labelledby="editManagerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editManagerModalLabel">Edit Manager</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editManagerForm">
                <div class="modal-body">
                    <input type="hidden" id="editManagerId" name="id">
                    <div class="mb-3">
                        <label for="editName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="editName" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="editEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="editEmail" name="email" required>
                    </div>
                    <div class="mb-3">
                        <label for="editPhone" class="form-label">Phone</label>
                        <input type="text" class="form-control" id="editPhone" name="phone">
                    </div>
                    <div class="mb-3">
                        <label for="editPassword" class="form-label">Password</label>
                        <input type="password" class="form-control" id="editPassword" name="password">
                    </div>
                    <div class="mb-3">
                        <label for="editRole" class="form-label">Role</label>
                        <select class="form-select" id="editRole" name="role" required>
                            <option value="">-- Select Role --</option>
                            <option value="admin">Admin</option>
                            <option value="manager">Manager</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Manager Confirmation -->
<form id="deleteManagerForm" action="/admin/managers/delete/{{this.id}}" method="POST" style="display: none;"></form>
<script>
    // Handle Add Manager Form
    document.getElementById('addManagerForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const data = Object.fromEntries(formData);
        
        try {
            const response = await fetch('/admin/managers/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });
            
            const result = await response.json();
            if (response.ok) {
                alert(result.message);
                location.reload();
            } else {
                alert(result.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('An error occurred');
        }
    });

    // Handle Edit Manager Form
    document.getElementById('editManagerForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const managerId = document.getElementById('editManagerId').value;
        const formData = new FormData(this);
        const data = Object.fromEntries(formData);
        
        try {
            const response = await fetch(`/admin/managers/edit/${managerId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });
            
            const result = await response.json();
            if (response.ok) {
                alert(result.message);
                location.reload();
            } else {
                alert(result.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('An error occurred');
        }
    });

    // Search and Filter Functionality
    const searchInput = document.getElementById('searchInput');
    const roleFilter = document.getElementById('roleFilter');
    const adminRows = document.querySelectorAll('.admin-row');
    const managerRows = document.querySelectorAll('.manager-row');
    const adminSectionTitle = document.getElementById('adminSectionTitle');
    const managerSectionTitle = document.getElementById('managerSectionTitle');
    const adminTableContainer = document.getElementById('adminTableContainer');
    const managerTableContainer = document.getElementById('managerTableContainer');
    const adminEmptyMsg = document.getElementById('adminEmptyMsg');
    const managerEmptyMsg = document.getElementById('managerEmptyMsg');

    function filterRows() {
        const searchText = searchInput.value.toLowerCase().trim();
        const selectedRole = roleFilter.value;

        let adminVisibleCount = 0;
        let managerVisibleCount = 0;

        // Filter admin rows
        adminRows.forEach(row => {
            const name = row.getAttribute('data-name').toLowerCase();
            const email = row.getAttribute('data-email').toLowerCase();

            // Check if row matches search
            const matchesSearch = searchText === '' || name.includes(searchText) || email.includes(searchText);
            
            // Check if row should be shown based on role filter
            const shouldShowByRole = selectedRole === '' || selectedRole === 'admin';

            if (matchesSearch && shouldShowByRole) {
                row.style.display = '';
                adminVisibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // Filter manager rows
        managerRows.forEach(row => {
            const name = row.getAttribute('data-name').toLowerCase();
            const email = row.getAttribute('data-email').toLowerCase();

            // Check if row matches search
            const matchesSearch = searchText === '' || name.includes(searchText) || email.includes(searchText);
            
            // Check if row should be shown based on role filter
            const shouldShowByRole = selectedRole === '' || selectedRole === 'manager';

            if (matchesSearch && shouldShowByRole) {
                row.style.display = '';
                managerVisibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

    // Show/hide sections and empty messages
        if (selectedRole === '' || selectedRole === 'admin') {
            adminSectionTitle.style.display = '';
            adminTableContainer.style.display = '';
            if (adminEmptyMsg) adminEmptyMsg.style.display = adminVisibleCount === 0 ? '' : 'none';
        } else {
            adminSectionTitle.style.display = 'none';
            adminTableContainer.style.display = 'none';
            if (adminEmptyMsg) adminEmptyMsg.style.display = 'none';
        }

        if (selectedRole === '' || selectedRole === 'manager') {
            managerSectionTitle.style.display = '';
            managerTableContainer.style.display = '';
            if (managerEmptyMsg) managerEmptyMsg.style.display = managerVisibleCount === 0 ? '' : 'none';
        } else {
            managerSectionTitle.style.display = 'none';
            managerTableContainer.style.display = 'none';
            if (managerEmptyMsg) managerEmptyMsg.style.display = 'none';
        }
    }

    // Event listeners for search and filter
    searchInput.addEventListener('input', filterRows);
    roleFilter.addEventListener('change', filterRows);
    
    // Initialize filter on page load with the default value
    filterRows();

    // Delete Manager
    document.querySelectorAll('.btn-danger').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            if (confirm('Are you sure you want to delete this user?')) {
                const userId = this.dataset.id;
                fetch('/admin/managers/delete/' + userId, {
                    method: 'POST'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('User deleted successfully');
                        location.reload();
                    } else {
                        alert('Error: ' + (data.message || 'Failed to delete user'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error deleting user');
                });
            }
        });
    });

    // Populate Edit Manager Modal
    document.querySelectorAll('[data-bs-target="#editManagerModal"]').forEach(button => {
        button.addEventListener('click', function() {
            document.getElementById('editManagerId').value = this.dataset.id;
            document.getElementById('editName').value = this.dataset.name;
            document.getElementById('editEmail').value = this.dataset.email;
            document.getElementById('editPhone').value = this.dataset.phone || '';
            document.getElementById('editPassword').value = '';
            document.getElementById('editRole').value = this.dataset.role;
        });
    });
</script>