<!-- Customer Account Locks -->
<div class="container-fluid">
    <div class="row">
        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Customer Account Locks</h1>
            </div>

            <!-- Customer Accounts Table -->
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer Name</th>
                            <th>Email</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each customers}}
                        <tr data-customer-id="{{this.id}}" data-customer-name="{{this.name}}" data-is-locked="{{this.is_locked}}">
                            <td>{{this.id}}</td>
                            <td>{{this.name}}</td>
                            <td>{{this.email}}</td>
                            <td class="text-center align-middle">
                                <span class="badge status-badge {{#if this.is_locked}}bg-danger{{else}}bg-success{{/if}} px-3">
                                    {{#if this.is_locked}}Locked{{else}}Active{{/if}}
                                </span>
                            </td>
                            <td class="text-center align-middle">
                                <button type="button" class="badge border-0 toggle-lock-btn {{#if this.is_locked}}bg-success{{else}}bg-danger{{/if}} px-3" data-customer-id="{{this.id}}" data-is-locked="{{this.is_locked}}">
                                    {{#if this.is_locked}}Unlock{{else}}Lock{{/if}}
                                </button>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            {{#if pagination.totalPages}}
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        {{#if pagination.hasPrevPage}}
                            <li class="page-item">
                                <a class="page-link" href="/admin/customer-locks?page={{subtract pagination.currentPage 1}}">Previous</a>
                            </li>
                        {{else}}
                            <li class="page-item disabled">
                                <span class="page-link">Previous</span>
                            </li>
                        {{/if}}

                        {{#each pagination.pages}}
                            {{#if (eq @index 0)}}
                                <!-- Show first 3 pages -->
                            {{/if}}
                            {{#if (lt @index 3)}}
                                <li class="page-item {{#eq ../pagination.currentPage (add @index 1)}}active{{/eq}}">
                                    <a class="page-link" href="/admin/customer-locks?page={{add @index 1}}">{{add @index 1}}</a>
                                </li>
                            {{else if (and (gte @index (subtract ../pagination.totalPages 3)) (lt @index ../pagination.totalPages))}}
                                <!-- Show last 3 pages -->
                                <li class="page-item {{#eq ../pagination.currentPage (add @index 1)}}active{{/eq}}">
                                    <a class="page-link" href="/admin/customer-locks?page={{add @index 1}}">{{add @index 1}}</a>
                                </li>
                            {{else if (and (gte @index 3) (lt @index (subtract ../pagination.totalPages 3)))}}
                                {{#if (eq @index 3)}}
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                {{/if}}
                            {{/if}}
                        {{/each}}

                        {{#if pagination.hasNextPage}}
                            <li class="page-item">
                                <a class="page-link" href="/admin/customer-locks?page={{add pagination.currentPage 1}}">Next</a>
                            </li>
                        {{else}}
                            <li class="page-item disabled">
                                <span class="page-link">Next</span>
                            </li>
                        {{/if}}
                    </ul>
                </nav>
            {{/if}}
        </main>
    </div>
</div>

<script>
    document.querySelectorAll('.toggle-lock-btn').forEach(button => {
        button.addEventListener('click', async function(e) {
            e.preventDefault();
            const customerId = this.dataset.customerId;
            const isLocked = this.dataset.isLocked === 'true';
            const customerName = this.closest('tr').dataset.customerName;
            const action = isLocked ? 'unlock' : 'lock';
            
            const confirmed = confirm(`Are you sure you want to ${action} ${customerName}'s account?`);
            
            if (confirmed) {
                try {
                    const response = await fetch(`/admin/customer-locks/toggle/${customerId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ action })
                    });
                    
                    const result = await response.json();
                    if (response.ok) {
                        alert(result.message);
                        location.reload();
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred');
                }
            }
        });
    });
</script>