<!-- Customer Account Locks -->
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {{> adminSidebar}}

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Customer Account Locks</h1>
            </div>

            <!-- Customer Accounts Table -->
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer Name</th>
                            <th>Email</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each customers}}
                        <tr>
                            <td>{{this.id}}</td>
                            <td>{{this.fullname}}</td>
                            <td>{{this.email}}</td>
                            <td class="text-center align-middle">
                                <span class="badge {{#if this.is_locked}}bg-danger{{else}}bg-success{{/if}} px-3">
                                    {{#if this.is_locked}}Locked{{else}}Active{{/if}}
                                </span>
                            </td>
                            <td class="text-center align-middle">
                                <form method="POST" action="/admin/customer-locks/toggle/{{this.id}}" class="d-inline">
                                    <button type="submit" class="badge border-0 {{#if this.is_locked}}bg-success{{else}}bg-danger{{/if}} px-3">
                                        {{#if this.is_locked}}Unlock{{else}}Lock{{/if}}
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>