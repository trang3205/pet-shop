<div class="py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                <i class="bi bi-envelope me-2"></i> Contact Messages
                {{#if unreadCount}}
                    <span class="badge bg-danger ms-2 animate-pulse">{{unreadCount}} new</span>
                {{/if}}
            </h1>
            <p class="text-muted mt-1">Total: {{totalContacts}} messages</p>
        </div>
    </div>

    {{#if error}}
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i> {{error}}
    </div>
    {{/if}}

    <!-- Messages Table -->
    {{#if contacts}}
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 20%">Name</th>
                        <th style="width: 25%">Email</th>
                        <th style="width: 30%">Subject</th>
                        <th style="width: 15%">Date</th>
                        <th style="width: 10%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each contacts}}
                    <tr class="align-middle {{#unless this.is_read}}table-light border-start border-danger border-3{{/unless}}" data-contact-id="{{this.id}}">
                        <td>
                            <strong>{{this.name}}</strong>
                            {{#unless this.is_read}}
                            <span class="badge bg-danger ms-2">New</span>
                            {{/unless}}
                        </td>
                        <td>
                            <a href="mailto:{{this.email}}" class="text-decoration-none">{{this.email}}</a>
                        </td>
                        <td>
                            <span class="text-muted">{{this.subject}}</span>
                        </td>
                        <td>
                            <small class="text-muted">
                                {{#if this.created_at}}
                                    {{formatDate this.created_at}}
                                {{/if}}
                            </small>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary view-btn me-2" data-contact-id="{{this.id}}" data-bs-toggle="modal" data-bs-target="#messageModal{{this.id}}" title="View Message">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger delete-btn" data-id="{{this.id}}" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modals for each message -->
    {{#each contacts}}
    <div class="modal fade" id="messageModal{{this.id}}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-envelope-open me-2 text-primary"></i> Message Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Name</label>
                        <p class="form-control-plaintext">{{this.name}}</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <p class="form-control-plaintext">
                            <a href="mailto:{{this.email}}">{{this.email}}</a>
                        </p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Subject</label>
                        <p class="form-control-plaintext">{{this.subject}}</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Message</label>
                        <div class="p-3 bg-light rounded border">
                            <p class="mb-0" style="white-space: pre-wrap;">{{this.message}}</p>
                        </div>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold">Received</label>
                        <p class="form-control-plaintext text-muted">
                            {{#if this.created_at}}
                                {{formatDateFull this.created_at}}
                            {{/if}}
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <a href="mailto:{{this.email}}" class="btn btn-primary">
                        <i class="bi bi-reply"></i> Reply
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/each}}

    <!-- Pagination -->
    {{#if (gt totalPages 1)}}
    <nav class="mt-4" aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            {{#if (gt currentPage 1)}}
            <li class="page-item">
                <a class="page-link" href="/admin/contacts?page=1">First</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="/admin/contacts?page={{subtract currentPage 1}}">Previous</a>
            </li>
            {{/if}}

            {{#each (arrayRange totalPages)}}
            <li class="page-item {{#if (eq this ../currentPage)}}active{{/if}}">
                <a class="page-link" href="/admin/contacts?page={{this}}">{{this}}</a>
            </li>
            {{/each}}

            {{#if (lt currentPage totalPages)}}
            <li class="page-item">
                <a class="page-link" href="/admin/contacts?page={{add currentPage 1}}">Next</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="/admin/contacts?page={{totalPages}}">Last</a>
            </li>
            {{/if}}
        </ul>
    </nav>
    {{/if}}
    {{else}}
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle me-2"></i> No messages yet.
    </div>
    {{/if}}
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle me-2"></i> Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this message? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .card {
        border-radius: 0.5rem;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.4rem 0.6rem;
    }

    .btn-sm {
        padding: 0.4rem 0.6rem;
        font-size: 0.875rem;
    }

    /* Animation for unread badge */
    @keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.7;
        }
    }

    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    /* Unread row highlight with transition */
    tr[data-contact-id] {
        transition: all 0.3s ease;
    }

    tr[data-contact-id].mark-read {
        animation: fadeOut 0.3s ease;
    }

    @keyframes fadeOut {
        from {
            background-color: #fff3cd;
        }
        to {
            background-color: transparent;
        }
    }

    /* Ensure buttons are clickable */
    .btn {
        pointer-events: auto !important;
        cursor: pointer !important;
        z-index: 10;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('✅ DOM loaded - initializing contact handlers');
        
        const deleteButtons = document.querySelectorAll('.delete-btn');
        const viewButtons = document.querySelectorAll('.view-btn');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const deleteModalElement = document.getElementById('deleteModal');
        
        let deleteId = null;
        let deleteModal = null;

        // Initialize delete modal
        if (deleteModalElement) {
            deleteModal = new bootstrap.Modal(deleteModalElement);
            console.log('✅ Delete modal initialized');
        } else {
            console.error('❌ Delete modal element not found');
        }

        console.log('📌 Found view buttons:', viewButtons.length);
        console.log('📌 Found delete buttons:', deleteButtons.length);

        // Handle View button - opens modal
        viewButtons.forEach((btn) => {
            btn.addEventListener('click', async function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const contactId = this.dataset.contactId;
                console.log('👁️ View button clicked - Contact ID:', contactId);
                
                const row = document.querySelector(`tr[data-contact-id="${contactId}"]`);
                
                // Mark as read if unread
                if (row && row.classList.contains('table-light')) {
                    try {
                        const response = await fetch(`/admin/contacts/${contactId}/read`, {
                            method: 'PUT',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });

                        if (response.ok) {
                            console.log('✅ Marked as read');
                            // Remove unread styling
                            row.classList.remove('table-light', 'border-start', 'border-danger', 'border-3');
                            row.classList.add('mark-read');
                            
                            // Update badge
                            const badge = row.querySelector('.badge.bg-danger');
                            if (badge) {
                                badge.remove();
                            }
                        }
                    } catch (error) {
                        console.error('❌ Error marking as read:', error);
                    }
                }
            });
        });

        // Handle Delete buttons
        deleteButtons.forEach((btn) => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                deleteId = this.dataset.id;
                console.log('🗑️ Delete button clicked - ID:', deleteId);
                
                if (deleteModal) {
                    deleteModal.show();
                    console.log('✅ Delete modal shown');
                } else {
                    console.error('❌ Delete modal not available');
                }
            });
        });

        // Handle Confirm Delete
        if (confirmDeleteBtn) {
            confirmDeleteBtn.addEventListener('click', async function() {
                if (!deleteId) {
                    console.error('❌ No delete ID set');
                    return;
                }

                console.log('🔄 Deleting contact:', deleteId);

                try {
                    const response = await fetch(`/admin/contacts/${deleteId}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        console.log('✅ Contact deleted successfully');
                        // Reload page
                        location.reload();
                    } else {
                        console.error('❌ Delete failed:', data.message);
                        alert('Error: ' + data.message);
                    }
                } catch (error) {
                    console.error('❌ Error deleting contact:', error);
                    alert('Lỗi khi xóa tin nhắn: ' + error.message);
                } finally {
                    if (deleteModal) {
                        deleteModal.hide();
                    }
                }
            });
        } else {
            console.error('❌ Confirm delete button not found');
        }
    });
</script>
