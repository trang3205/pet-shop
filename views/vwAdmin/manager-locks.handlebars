<!-- Manager Account Locks -->
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        {{> adminSidebar}}

        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Manager Account Locks</h1>
            </div>

            <!-- Manager Accounts Table -->
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Manager Name</th>
                            <th>Email</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each managers}}
                        <tr data-manager-id="{{this.id}}" data-manager-name="{{this.name}}" data-is-locked="{{this.is_locked}}">
                            <td>{{this.id}}</td>
                            <td>{{this.name}}</td>
                            <td>{{this.email}}</td>
                            <td class="text-center align-middle">
                                <span class="badge status-badge {{#if this.is_locked}}bg-danger{{else}}bg-success{{/if}} px-3">
                                    {{#if this.is_locked}}Locked{{else}}Active{{/if}}
                                </span>
                            </td>
                            <td class="text-center align-middle">
                                <button type="button" class="badge border-0 toggle-lock-btn {{#if this.is_locked}}bg-success{{else}}bg-danger{{/if}} px-3" data-manager-id="{{this.id}}" data-is-locked="{{this.is_locked}}">
                                    {{#if this.is_locked}}Unlock{{else}}Lock{{/if}}
                                </button>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<script>
    document.querySelectorAll('.toggle-lock-btn').forEach(button => {
        button.addEventListener('click', async function(e) {
            e.preventDefault();
            const managerId = this.dataset.managerId;
            const isLocked = this.dataset.isLocked === 'true';
            const managerName = this.closest('tr').dataset.managerName;
            const action = isLocked ? 'unlock' : 'lock';
            
            const confirmed = confirm(`Are you sure you want to ${action} ${managerName}'s account?`);
            
            if (confirmed) {
                try {
                    const response = await fetch(`/admin/manager-locks/toggle/${managerId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ action })
                    });
                    
                    const result = await response.json();
                    if (response.ok) {
                        alert(result.message);
                        location.reload();
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred');
                }
            }
        });
    });
</script>