<div class="container-fluid">
    <div class="row">
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Activity History</h1>
            </div>

            <!-- Filter Section -->
            <div class="row mb-4 p-3 bg-light rounded">
                <div class="col-md-4 mb-2">
                    <label class="form-label fw-bold">Filter By Role</label>
                    <select id="roleFilter" class="form-select">
                        <option value="">-- All Roles --</option>
                        {{#each roles}}
                            <option value="{{this}}" {{#if (eq this ../filterByRole)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label fw-bold">Filter By Name</label>
                    <input type="text" id="nameFilter" class="form-control" placeholder="Enter user's name" value="{{filterByName}}">
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label fw-bold">Filter By Date</label>
                    <input type="date" id="dateFilter" class="form-control" value="{{formatDateForInput filterByDate}}">
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mb-3">
                <button class="btn btn-primary" onclick="applyFilters()">
                    <i class="bi bi-search"></i> Search
                </button>
                <button class="btn btn-secondary" onclick="clearFilters()">
                    <i class="bi bi-x-circle"></i> Remove Filter
                </button>
            </div>

            {{#if sessions}}
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">User Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Role</th>
                            <th scope="col">Login Time</th>
                            <th scope="col">Logout Time</th>
                            <th scope="col">Duration (mins)</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each sessions}}
                            <tr>
                                <td>{{this.name}}</td>
                                <td>{{this.email}}</td>
                                <td>
                                    {{#if (eq this.role 'admin')}}
                                        <span class="badge bg-warning text-dark">admin</span>
                                    {{else}}
                                        {{#if (eq this.role 'manager')}}
                                            <span class="badge bg-info text-dark">manager</span>
                                        {{else}}
                                            <span class="badge bg-secondary text-dark">{{this.role}}</span>
                                        {{/if}}
                                    {{/if}}
                                </td>
                                <td>{{formatDateFull this.login_time}}</td>
                                <td>
                                    {{#if this.logout_time}}
                                        {{formatDateFull this.logout_time}}
                                    {{else}}
                                        <span class="badge bg-success text-dark">Active</span>
                                    {{/if}}
                                </td>
                                <td>
                                    {{#if this.logout_time}}
                                        {{calculateDuration this.login_time this.logout_time}}
                                    {{else}}
                                        -
                                    {{/if}}
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm" onclick="viewUserSessions('{{this.user_id}}')">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>

                <!-- Pagination -->
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <!-- Previous Button -->
                        <li class="page-item {{#if (lte currentPage 1)}}disabled{{/if}}">
                            <a class="page-link" href="?{{#if filterByRole}}role={{filterByRole}}&{{/if}}{{#if filterByName}}name={{filterByName}}&{{/if}}{{#if filterByDate}}date={{filterByDate}}&{{/if}}page={{subtract currentPage 1}}" {{#if (lte currentPage 1)}}onclick="return false;"{{/if}}>Previous</a>
                        </li>

                        <!-- Page Numbers -->
                        {{#each pagination.pages}}
                            {{#if (eq this ../currentPage)}}
                                <li class="page-item active">
                                    <span class="page-link">{{this}}</span>
                                </li>
                            {{else}}
                                <li class="page-item">
                                    <a class="page-link" href="?{{#if ../filterByRole}}role={{../filterByRole}}&{{/if}}{{#if ../filterByName}}name={{../filterByName}}&{{/if}}{{#if ../filterByDate}}date={{../filterByDate}}&{{/if}}page={{this}}">{{this}}</a>
                                </li>
                            {{/if}}
                        {{/each}}

                        <!-- Next Button -->
                        <li class="page-item {{#if (gte currentPage totalPages)}}disabled{{/if}}">
                            <a class="page-link" href="?{{#if filterByRole}}role={{filterByRole}}&{{/if}}{{#if filterByName}}name={{filterByName}}&{{/if}}{{#if filterByDate}}date={{filterByDate}}&{{/if}}page={{add currentPage 1}}" {{#if (gte currentPage totalPages)}}onclick="return false;"{{/if}}>Next</a>
                        </li>
                    </ul>
                </nav>
            {{else}}
                <div class="alert alert-info" role="alert">
                    No activity records found. Activity will appear here when users log in and out.
                </div>
            {{/if}}
        </main>
    </div>
</div>

<script>
    function viewUserSessions(userId) {
        window.location.href = `/admin/activity-history/user/${userId}`;
    }

    function applyFilters() {
        const role = document.getElementById('roleFilter').value;
        const name = document.getElementById('nameFilter').value;
        const date = document.getElementById('dateFilter').value;
        
        let url = '?';
        if (role) url += `role=${encodeURIComponent(role)}&`;
        if (name) url += `name=${encodeURIComponent(name)}&`;
        if (date) url += `date=${encodeURIComponent(date)}&`;
        url += 'page=1';
        
        window.location.href = url;
    }

    function clearFilters() {
        window.location.href = '?';
    }
</script>
