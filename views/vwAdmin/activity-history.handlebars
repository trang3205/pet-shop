<div class="container-fluid">
    <div class="row">
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Activity History</h1>
            </div>

            <!-- Sort Filter -->
            <div class="mb-3">
                <label class="form-label fw-bold">Sort by:</label>
                <select class="form-select" style="max-width: 250px;" onchange="changeSortBy(this.value)">
                    <option value="default" {{#if (eq sortBy 'default')}}selected{{/if}}>Default</option>
                    <option value="name" {{#if (eq sortBy 'name')}}selected{{/if}}>Name</option>
                    <option value="date" {{#if (eq sortBy 'date')}}selected{{/if}}>Date</option>
                </select>
            </div>

            {{#if sessions}}
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">User Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Role</th>
                            <th scope="col">Login Time</th>
                            <th scope="col">Logout Time</th>
                            <th scope="col">Duration (mins)</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each sessions}}
                            <tr>
                                <td>{{this.name}}</td>
                                <td>{{this.email}}</td>
                                <td>
                                    {{#if (eq this.role 'admin')}}
                                        <span class="badge bg-warning text-dark">admin</span>
                                    {{else}}
                                        {{#if (eq this.role 'manager')}}
                                            <span class="badge bg-info text-dark">manager</span>
                                        {{else}}
                                            <span class="badge bg-secondary text-dark">{{this.role}}</span>
                                        {{/if}}
                                    {{/if}}
                                </td>
                                <td>{{formatDateFull this.login_time}}</td>
                                <td>
                                    {{#if this.logout_time}}
                                        {{formatDateFull this.logout_time}}
                                    {{else}}
                                        <span class="badge bg-success text-dark">Active</span>
                                    {{/if}}
                                </td>
                                <td>
                                    {{#if this.logout_time}}
                                        {{calculateDuration this.login_time this.logout_time}}
                                    {{else}}
                                        -
                                    {{/if}}
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm" onclick="viewUserSessions('{{this.user_id}}')">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>

                <!-- Pagination -->
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <!-- Previous Button -->
                        <li class="page-item {{#if (lte currentPage 1)}}disabled{{/if}}">
                            <a class="page-link" href="?sortBy={{sortBy}}&page={{subtract currentPage 1}}" {{#if (lte currentPage 1)}}onclick="return false;"{{/if}}>Previous</a>
                        </li>

                        <!-- Page Numbers -->
                        {{#each pageArray}}
                            {{#if (eq this ../currentPage)}}
                                <li class="page-item active">
                                    <span class="page-link">{{this}}</span>
                                </li>
                            {{else}}
                                <li class="page-item">
                                    <a class="page-link" href="?sortBy={{../sortBy}}&page={{this}}">{{this}}</a>
                                </li>
                            {{/if}}
                        {{/each}}

                        <!-- Next Button -->
                        <li class="page-item {{#if (gte currentPage totalPages)}}disabled{{/if}}">
                            <a class="page-link" href="?sortBy={{sortBy}}&page={{add currentPage 1}}" {{#if (gte currentPage totalPages)}}onclick="return false;"{{/if}}>Next</a>
                        </li>
                    </ul>
                </nav>
            {{else}}
                <div class="alert alert-info" role="alert">
                    No activity records found. Activity will appear here when users log in and out.
                </div>
            {{/if}}
        </main>
    </div>
</div>

<script>
    function viewUserSessions(userId) {
        window.location.href = `/admin/activity-history/user/${userId}`;
    }

    function changeSortBy(value) {
        window.location.href = `?sortBy=${value}&page=1`;
    }
</script>
