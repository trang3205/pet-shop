<!-- Products Management -->
<div class="container-fluid">
    <div class="row">
        <!-- Main Content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Products Management</h1>
            </div>

            <!-- Search and Filters -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <form method="GET" action="/admin/products" class="d-flex">
                        <input type="text" class="form-control" name="search" placeholder="Search products..." value="{{search}}">
                        <button class="btn btn-outline-secondary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="categoryFilter" onchange="redirectToCategory()" data-category="{{category}}">
                        <option value="">All Categories</option>
                        {{#each categories}}
                        <option value="{{this.id}}">{{this.name}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="sortFilter" onchange="sortProducts()">
                        <option value="name" {{#if (eq sortBy 'name')}}selected{{/if}}>Sort by Name</option>
                        <option value="price" {{#if (eq sortBy 'price')}}selected{{/if}}>Sort by Price</option>
                    </select>
                </div>
            </div>

            <!-- Products Grid -->
            {{#if products}}
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                {{#each products}}
                <div class="col">
                    <div class="card h-100">
                        {{#if this.image_url}}
                        <img src="{{this.image_url}}" class="card-img-top p-2" alt="{{this.name}}">
                        {{else}}
                        <div class="card-img-top p-2 bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-muted">No Image</span>
                        </div>
                        {{/if}}
                        <div class="card-body">
                            <h5 class="card-title">{{this.name}}</h5>
                            <p class="card-text text-muted small">Category: {{this.category_id}}</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="h6 mb-0">${{this.price}}</span>
                                {{#if (eq this.stock 0)}}
                                <span class="badge bg-danger">Out of Stock</span>
                                {{else if (eq this.stock 1)}}
                                <span class="badge bg-warning">Low Stock</span>
                                {{else if (eq this.stock 2)}}
                                <span class="badge bg-warning">Low Stock</span>
                                {{else if (eq this.stock 3)}}
                                <span class="badge bg-warning">Low Stock</span>
                                {{else if (eq this.stock 4)}}
                                <span class="badge bg-warning">Low Stock</span>
                                {{else if (eq this.stock 5)}}
                                <span class="badge bg-warning">Low Stock</span>
                                {{else if (eq this.stock 6)}}
                                <span class="badge bg-warning">Low Stock</span>
                                {{else if (eq this.stock 7)}}
                                <span class="badge bg-warning">Low Stock</span>
                                {{else if (eq this.stock 8)}}
                                <span class="badge bg-warning">Low Stock</span>
                                {{else if (eq this.stock 9)}}
                                <span class="badge bg-warning">Low Stock</span>
                                {{else}}
                                <span class="badge bg-success">In Stock</span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>

            <!-- Pagination -->
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    {{#if (eq currentPage 1)}}
                    <li class="page-item disabled">
                        <a class="page-link" href="#">Previous</a>
                    </li>
                    {{else}}
                    <li class="page-item">
                        <a class="page-link" href="/admin/products?page={{subtract currentPage 1}}&search={{search}}&category={{category}}&sort={{sortBy}}">Previous</a>
                    </li>
                    {{/if}}

                    {{#each (arrayRange totalPages)}}
                    <li class="page-item {{#if (eq this ../currentPage)}}active{{/if}}">
                        <a class="page-link" href="/admin/products?page={{this}}&search={{../search}}&category={{../category}}&sort={{../sortBy}}">{{this}}</a>
                    </li>
                    {{/each}}

                    {{#if (eq currentPage totalPages)}}
                    <li class="page-item disabled">
                        <a class="page-link" href="#">Next</a>
                    </li>
                    {{else}}
                    <li class="page-item">
                        <a class="page-link" href="/admin/products?page={{add currentPage 1}}&search={{search}}&category={{category}}&sort={{sortBy}}">Next</a>
                    </li>
                    {{/if}}
                </ul>
            </nav>
            {{else}}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i>
                No products found.
            </div>
            {{/if}}
        </main>
    </div>
</div>

<style>
.card-img-top {
    height: 200px;
    object-fit: cover;
}
</style>

<script>
// Set select value on page load
document.addEventListener('DOMContentLoaded', function() {
    const categoryFilter = document.getElementById('categoryFilter');
    const category = categoryFilter.getAttribute('data-category');
    if (category && category !== '') {
        categoryFilter.value = category;
    } else {
        categoryFilter.value = '';
    }
});

function redirectToCategory() {
    const select = document.getElementById('categoryFilter');
    const category = select.options[select.selectedIndex].value;
    const params = new URLSearchParams(window.location.search);
    const search = params.get('search') || '';
    const sort = params.get('sort') || 'name';
    
    let url = '/admin/products?page=1';
    if (search) url += '&search=' + encodeURIComponent(search);
    if (category) url += '&category=' + encodeURIComponent(category);
    if (sort && sort !== 'name') url += '&sort=' + encodeURIComponent(sort);
    
    window.location.href = url;
}

function sortProducts() {
    const select = document.getElementById('sortFilter');
    const sort = select.options[select.selectedIndex].value;
    const params = new URLSearchParams(window.location.search);
    const search = params.get('search') || '';
    const category = params.get('category') || '';
    
    let url = '/admin/products?page=1';
    if (search) url += '&search=' + encodeURIComponent(search);
    if (category) url += '&category=' + encodeURIComponent(category);
    url += '&sort=' + encodeURIComponent(sort);
    
    window.location.href = url;
}

function openAddModal() {
    alert('Add product feature coming soon');
}

function editProduct(id) {
    alert('Edit product feature coming soon: ' + id);
}

function deleteProduct(id) {
    if (confirm('Are you sure you want to delete this product?')) {
        alert('Delete product feature coming soon: ' + id);
    }
}
</script>