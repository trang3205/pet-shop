<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - PetShop Admin</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Custom Admin Styles -->
    <style>
        body {
            font-size: .875rem;
        }

        .sidebar {
            position: relative;
            padding-top: 0;
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
            min-height: 100vh;
        }

        .sidebar .nav-link {
            font-weight: 500;
            color: #333;
            padding: 0.7rem 1rem;
            transition: all 0.3s ease;
        }

        .sidebar .nav-link:hover {
            background-color: #e9ecef;
            transform: translateX(5px);
        }

        .sidebar .nav-link.active {
            color: #007bff;
            background-color: #e8f1ff;
            border-right: 3px solid #007bff;
        }

        .sidebar .nav-link i {
            margin-right: 8px;
            width: 20px;
            text-align: center;
        }

        .sidebar-sticky {
            position: relative;
            top: 0;
            padding-top: .5rem;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .navbar-brand {
            padding-top: .75rem;
            padding-bottom: .75rem;
            font-size: 1rem;
            background-color: rgba(0, 0, 0, .25);
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .25);
        }

        .profile-dropdown {
            position: relative;
        }

        .profile-toggle {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            padding: 0.5rem 1rem;
            border: none;
            background: transparent;
            color: white;
            transition: all 0.3s ease;
        }

        .profile-toggle:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 0.25rem;
        }

        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            font-weight: bold;
            color: white;
            font-size: 0.875rem;
        }

        .profile-menu {
            position: absolute;
            right: 0;
            top: 100%;
            background: white;
            border: 1px solid #ddd;
            border-radius: 0.25rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
            min-width: 220px;
            z-index: 1000;
            display: none;
        }

        .profile-menu.show {
            display: block;
        }

        .profile-menu-header {
            padding: 1rem;
            border-bottom: 1px solid #ddd;
            background-color: #f8f9fa;
        }

        .profile-name {
            font-weight: 600;
            color: #333;
            margin: 0;
        }

        .profile-role {
            font-size: 0.75rem;
            color: #666;
            margin: 0.25rem 0 0 0;
        }

        .profile-menu-items {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .profile-menu-item {
            margin: 0;
        }

        .profile-menu-item a {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            color: #333;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .profile-menu-item a:hover {
            background-color: #f0f0f0;
            color: #007bff;
        }

        .profile-menu-item form {
            margin: 0;
        }

        .profile-menu-item button {
            width: 100%;
            text-align: left;
            border: none;
            background: none;
            padding: 0.75rem 1rem;
            color: #333;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: inherit;
            font-size: inherit;
        }

        .profile-menu-item button:hover {
            background-color: #f0f0f0;
            color: #007bff;
        }

        .profile-menu-item i {
            width: 18px;
            text-align: center;
        }

        .profile-menu-divider {
            height: 1px;
            background-color: #ddd;
            margin: 0.5rem 0;
        }

        .sidebar h6 {
            margin-bottom: 0.5rem;
            margin-top: 0.5rem;
        }

        .nav-item.border-top {
            border-color: #dee2e6 !important;
        }

        .sidebar .nav-item i {
            min-width: 20px;
            text-align: center;
        }
    </style>
</head>

<body>
    <!-- Top Navigation -->
    <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3" href="/admin">PetShop Admin</a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="w-100"></div>
        <div class="navbar-nav">
            <div class="nav-item text-nowrap profile-dropdown">
                <button class="profile-toggle" id="profileToggle">
                    <div class="profile-avatar-large" style="width:36px; height:36px;">
                        {{#if user.avatar_url}}
                            <img src="/static/imgs/{{user.avatar_url}}" 
                                alt="Profile"
                                style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
                        {{else}}
                            {{user.name.[0]}}
                        {{/if}}
                    </div>



                    <div>
                        <div style="font-size: 0.875rem;">Welcome, {{#if user}}{{user.name}}{{else}}Admin{{/if}}</div>
                    </div>
                </button>
                <div class="profile-menu" id="profileMenu">
                    <div class="profile-menu-header">
                        <p class="profile-name">{{#if user}}{{user.name}}{{else}}Admin{{/if}}</p>
                        <p class="profile-role">Administrator</p>
                    </div>
                    <ul class="profile-menu-items">
                        <li class="profile-menu-item">
                            <a href="/admin/profile">
                                <i class="bi bi-person-circle"></i>
                                <span>Profile</span>
                            </a>
                        </li>
                        <div class="profile-menu-divider"></div>
                        <li class="profile-menu-item">
                            <form method="POST" action="/account/logout" style="margin: 0;">
                                <button type="submit" style="width: 100%; text-align: left; border: none; background: none; padding: 0.75rem 1rem; color: #333; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; cursor: pointer; transition: all 0.2s ease;">
                                    <i class="bi bi-box-arrow-right" style="width: 18px; text-align: center;"></i>
                                    <span>Sign Out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                <div class="sidebar-sticky pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link {{#if (eq active 'dashboard')}}active{{/if}}" href="/admin/dashboard">
                                <i class="bi bi-house-door"></i>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{#if (eq active 'customers')}}active{{/if}}" href="/admin/customers">
                                <i class="bi bi-people"></i>
                                Customers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{#if (eq active 'managers')}}active{{/if}}" href="/admin/managers">
                                <i class="bi bi-person-badge"></i>
                                Managers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{#if (eq active 'products')}}active{{/if}}" href="/admin/products">
                                <i class="bi bi-box"></i>
                                Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{#if (eq active 'customer-locks')}}active{{/if}}" href="/admin/customer-locks">
                                <i class="bi bi-lock"></i>
                                Customer Locks
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{#if (eq active 'manager-locks')}}active{{/if}}" href="/admin/manager-locks">
                                <i class="bi bi-shield-lock"></i>
                                Manager Locks
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{#if (eq active 'shop-settings')}}active{{/if}}" href="/admin/shop-settings">
                                <i class="bi bi-gear"></i>
                                Shop Settings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{#if (eq active 'contacts')}}active{{/if}}" href="/admin/contacts">
                                <i class="bi bi-envelope"></i>
                                Contact
                                {{#if (gt unreadCount 0)}}
                                <span class="badge bg-danger ms-2">{{unreadCount}}</span>
                                {{/if}}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/activity-history">
                                <i class="bi bi-clock-history"></i>
                                <span>Activity History</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Conten
                        t -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                {{{body}}}
            </main>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Profile Dropdown Script -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const profileToggle = document.getElementById('profileToggle');
        const profileMenu = document.getElementById('profileMenu');
        const profileInitial = document.getElementById('profileInitial');
        const profileAvatarImg = document.getElementById('profileAvatarImg');

        // Nếu không có avatar_url → dùng chữ cái đầu
        if (!profileAvatarImg && profileInitial) {
            const userNameElement = document.querySelector('.profile-toggle div:last-child div:first-child');
            if (userNameElement) {
                const userName = userNameElement.textContent.replace('Welcome, ', '').trim();
                if (userName && userName !== 'Admin') {
                    profileInitial.textContent = userName.charAt(0).toUpperCase();
                }
            }
        }

        // Toggle menu on button click
        profileToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            profileMenu.classList.toggle('show');
        });

        // Close menu when clicking outside
        document.addEventListener('click', function(e) {
            if (!profileToggle.contains(e.target) && !profileMenu.contains(e.target)) {
                profileMenu.classList.remove('show');
            }
        });

        // Close menu when clicking a menu item
        profileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function() {
                profileMenu.classList.remove('show');
            });
        });
    });
</script>

    
    <!-- Add any additional scripts here -->
    {{{_sections.scripts}}}
</body>
</html>