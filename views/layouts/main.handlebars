<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if shop.name}}{{shop.name}}{{else}}PetShop{{/if}} - Cửa hàng vật phẩm thú cưng</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Custom Styles -->
    <style>
        /* Footer Styles */
        footer {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            color: #fff;
        }

        footer .fw-bold {
            color: #fff;
            font-size: 1.1rem;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        footer .text-muted {
            color: #bbb !important;
            transition: color 0.3s ease;
        }

        footer ul li {
            margin-bottom: 0.7rem;
            display: flex;
            align-items: center;
        }

        footer ul li i {
            margin-right: 0.7rem;
            font-size: 1.1rem;
            min-width: 20px;
        }

        footer a {
            color: #bbb;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        footer a:hover {
            color: #0d6efd;
        }

        footer .social-links a {
            font-size: 1.3rem;
            transition: all 0.3s ease;
        }

        footer .social-links a:hover {
            color: #0d6efd;
            transform: translateY(-3px);
        }

        footer hr {
            border-color: #444;
        }

        footer .social-links {
            margin-top: 1rem;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header>
        <!-- Top Bar -->
        <div class="bg-light border-bottom">
            <div class="container">
                <div class="row py-2">
                    <div class="col-md-6">
                        <small>Miễn phí vận chuyển cho đơn từ 500.000đ</small>
                    </div>
                    <div class="col-md-6 text-end">
                        <small>
                            {{#if user}}
                            <div class="dropdown d-inline-block">
                                <a href="#" class="text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> {{user.name}}
                                    {{#ifEqual user.role 'admin'}}
                                    <span class="badge bg-danger ms-1">Admin</span>
                                    {{/ifEqual}}
                                    {{#ifEqual user.role 'manager'}}
                                    <span class="badge bg-success ms-1">Manager</span>
                                    {{/ifEqual}}
                                    {{#ifEqual user.role 'customer'}}
                                    <span class="badge bg-primary ms-1">Customer</span>
                                    {{/ifEqual}}
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">

                                    {{!-- ADMIN MENU --}}
                                    {{#ifEqual user.role 'admin'}}
                                    <li>
                                        <h6 class="dropdown-header text-danger">System Admin</h6>
                                    </li>
                                    <li><a class="dropdown-item" href="/admin/dashboard">
                                            <i class="bi bi-speedometer2"></i> Dashboard
                                        </a></li>
                                    <li><a class="dropdown-item" href="/admin/products">
                                            <i class="bi bi-box-seam"></i> Quản lý sản phẩm
                                        </a></li>
                                    <li><a class="dropdown-item" href="/admin/orders">
                                            <i class="bi bi-receipt"></i> Quản lý đơn hàng
                                        </a></li>
                                    <li><a class="dropdown-item" href="/admin/categories">
                                            <i class="bi bi-tags"></i> Quản lý danh mục
                                        </a></li>
                                    <li><a class="dropdown-item" href="/admin/users">
                                            <i class="bi bi-people"></i> Quản lý người dùng
                                        </a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    {{/ifEqual}}

                                    {{!-- MANAGER MENU --}}
                                    {{#ifEqual user.role 'manager'}}
                                    <li>
                                        <h6 class="dropdown-header text-success">Store Manager</h6>
                                    </li>
                                    <li><a class="dropdown-item" href="/manager/dashboard">
                                            <i class="bi bi-speedometer2"></i> Dashboard
                                        </a></li>
                                    <li><a class="dropdown-item" href="/manager/products">
                                            <i class="bi bi-box-seam"></i> Quản lý sản phẩm
                                        </a></li>
                                    <li><a class="dropdown-item" href="/manager/orders">
                                            <i class="bi bi-receipt"></i> Quản lý đơn hàng
                                        </a></li>
                                    <li><a class="dropdown-item" href="/manager/categories">
                                            <i class="bi bi-tags"></i> Quản lý danh mục
                                        </a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    {{/ifEqual}}

                                    {{!-- CUSTOMER MENU --}}
                                    {{#ifEqual user.role 'customer'}}
                                    <li>
                                        <h6 class="dropdown-header text-primary">🛒 Khu vực khách hàng</h6>
                                    </li>
                                    <li><a class="dropdown-item" href="/account/profile">
                                            <i class="bi bi-person"></i> Tài khoản của tôi
                                        </a></li>
                                    <li><a class="dropdown-item" href="/account/orders">
                                            <i class="bi bi-bag"></i> Đơn hàng của tôi
                                        </a></li>
                                    <li><a class="dropdown-item" href="/user/addresses">
                                            <i class="bi bi-geo-alt"></i> Địa chỉ của tôi
                                        </a></li>
                                    <li><a class="dropdown-item" href="/user/wishlist">
                                            <i class="bi bi-heart"></i> Sản phẩm yêu thích
                                        </a></li>
                                    <li><a class="dropdown-item" href="/user/reviews">
                                            <i class="bi bi-star"></i> Đánh giá của tôi
                                        </a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    {{/ifEqual}}

                                    {{!-- MENU CHUNG --}}
                                    <li><a class="dropdown-item" href="/account/profile">
                                            <i class="bi bi-gear"></i> Cài đặt tài khoản
                                        </a></li>
                                    <li>
                                        <form action="/account/logout" method="POST" class="d-inline">
                                            <button type="submit" class="dropdown-item border-0 bg-transparent">
                                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                            {{else}}
                            <a href="/account/login" class="text-decoration-none">Đăng nhập</a>
                            <span class="mx-1">|</span>
                            <a href="/account/register" class="text-decoration-none">Đăng ký</a>
                            {{/if}}
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Navigation -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand fw-bold text-primary" href="/">
                    <i class="bi bi-heart-fill"></i> {{#if shop.name}}{{shop.name}}{{else}}PetShop{{/if}}
                </a>

                <!-- Search Bar -->
                <div class="mx-4 flex-grow-1">
                    <form action="/products/search" method="GET" class="d-flex">
                        <input class="form-control me-2" type="search" name="q" placeholder="Tìm sản phẩm..."
                            aria-label="Search">
                        <button class="btn btn-outline-primary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>

                <!-- Navigation Links -->
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" href="/">
                        <i class="bi bi-house"></i> Trang chủ
                    </a>
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-grid"></i> Danh mục
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/categories">
                                    <i class="bi bi-list-ul"></i> Tất cả danh mục
                                </a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            {{#each categories}}
                            <li>
                                <a class="dropdown-item" href="/categories/{{this.id}}">
                                    {{this.name}}
                                </a>
                            </li>
                            {{#ifDivider @index categories}}
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            {{/ifDivider}}
                            {{/each}}
                        </ul>
                    </div>

                    <!-- Sửa Navigation Link "Sản phẩm" thành "Danh mục" -->
                   
                    <a class="nav-link" href="/categories">
                        <i class="bi bi-shop"></i> Sản phẩm
                    </a>

                    <!-- User Actions -->
                    <!-- User Actions - Ẩn với Admin/Manager -->
                    {{#ifEqual user.role 'customer'}}
                    <div class="d-flex ms-3">
                        <a class="nav-link position-relative" href="/user/wishlist">
                            <i class="bi bi-heart"></i>
                            <span
                                class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                0
                            </span>
                        </a>
                        <a class="nav-link position-relative" href="/cart">
                            <i class="bi bi-cart3"></i>
                            <span
                                class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                {{cartItemsCount}}
                            </span>
                        </a>
                    </div>
                    {{/ifEqual}}
                </div>
            </div>
        </nav>
    </header>

    <!-- Flash Messages -->
    {{#if success}}
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{{success}}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
    {{/if}}

    {{#if error}}
    <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{{error}}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
    {{/if}}

    <!-- Main Content -->
    <main class="flex-shrink-0">
        {{{body}}}
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-2 mb-4">
                    <h5 class="fw-bold text-white mb-3">
                        <i class="bi bi-heart-fill text-danger"></i> 
                        {{#if shop.name}}{{shop.name}}{{else}}PetShop{{/if}}
                    </h5>
                    <p class="text-muted small">Cung cấp các sản phẩm chất lượng cao cho thú cưng của bạn.</p>
                    <div class="social-links">
                        <a href="#" class="text-light me-3" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-light me-3" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-light me-3" title="TikTok"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold text-white">Mua sắm</h6>
                    <ul class="list-unstyled">
                        <li><a href="/categories" class="text-decoration-none text-muted"><i class="bi bi-chevron-right"></i> Tất cả danh mục</a></li>
                        {{#each categories}}
                        <li>
                            <a href="/categories/{{this.id}}" class="text-decoration-none text-muted"><i class="bi bi-chevron-right"></i> {{this.name}}</a>
                        </li>
                        {{/each}}
                    </ul>
                </div>

                <div class="col-md-3 mb-4">
                    <h6 class="fw-bold text-white">Hỗ trợ</h6>
                    <ul class="list-unstyled">
                        <li><a href="/about" class="text-decoration-none text-muted"><i class="bi bi-chevron-right"></i> Về chúng tôi</a></li>
                        <li><a href="/contact" class="text-decoration-none text-muted"><i class="bi bi-chevron-right"></i> Liên hệ</a></li>
                        <li><a href="/shipping" class="text-decoration-none text-muted"><i class="bi bi-chevron-right"></i> Chính sách vận chuyển</a></li>
                        <li><a href="/return" class="text-decoration-none text-muted"><i class="bi bi-chevron-right"></i> Chính sách đổi trả</a></li>
                    </ul>
                </div>

                <div class="col-md-3 mb-4">
                    <h6 class="fw-bold">Liên hệ</h6>
                    <ul class="list-unstyled text-muted">
                        {{#if shop}}
                            {{#if shop.street_address}}
                            <li class="mb-2">
                                <i class="bi bi-geo-alt text-primary"></i> 
                                <span>{{shop.street_address}}{{#if shop.ward}}, {{shop.ward}}{{/if}}{{#if shop.district}}, {{shop.district}}{{/if}}{{#if shop.province}}, {{shop.province}}{{/if}}</span>
                            </li>
                            {{/if}}
                            {{#if shop.phone}}
                            <li class="mb-2">
                                <i class="bi bi-telephone text-primary"></i> 
                                <a href="tel:{{shop.phone}}" class="text-decoration-none text-muted">{{shop.phone}}</a>
                            </li>
                            {{/if}}
                            {{#if shop.email}}
                            <li class="mb-2">
                                <i class="bi bi-envelope text-primary"></i> 
                                <a href="mailto:{{shop.email}}" class="text-decoration-none text-muted">{{shop.email}}</a>
                            </li>
                            {{/if}}
                            {{#if shop.name}}
                            <li class="mb-2">
                                <i class="bi bi-shop text-primary"></i> 
                                <span>{{shop.name}}</span>
                            </li>
                            {{/if}}
                        {{else}}
                            <li class="mb-2">
                                <i class="bi bi-geo-alt text-primary"></i> 
                                <span>Địa chỉ: Đang cập nhật</span>
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-telephone text-primary"></i> 
                                <span>Hotline: Đang cập nhật</span>
                            </li>
                        {{/if}}
                        <li class="mb-2">
                            <i class="bi bi-clock text-primary"></i> 
                            <span>8:00 - 22:00 (Hàng ngày)</span>
                        </li>
                    </ul>
                </div>
            </div>

            <hr class="my-4">

            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="text-muted mb-0 small">&copy; 2024 {{#if shop.name}}{{shop.name}}{{else}}PetShop{{/if}}. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-end">
                    <span class="text-muted small me-3">Accepted Payments:</span>
                    <i class="bi bi-credit-card text-primary me-2"></i>
                    <i class="bi bi-phone text-success me-2"></i>
                    <i class="bi bi-cash-coin text-warning"></i>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script>
        // Auto-hide alerts after 5 seconds (only success/error alerts, not content alerts)
        document.addEventListener('DOMContentLoaded', function () {
            const alerts = document.querySelectorAll('.alert-success, .alert-danger:not(.border-2)');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
        });
    </script>
</body>

</html>