<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetShop - Cửa hàng vật phẩm thú cưng</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <!-- Header -->
    <header>
        <!-- Top Bar -->
        <div class="bg-light border-bottom">
            <div class="container">
                <div class="row py-2">
                    <div class="col-md-6">
                        <small>🛵 Miễn phí vận chuyển cho đơn từ 500.000đ</small>
                    </div>
                    <div class="col-md-6 text-end">
                        <small>
                            {{#if user}}
                                <div class="dropdown d-inline-block">
                                    <a href="#" class="text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                                        <i class="bi bi-person-circle"></i> {{user.name}}
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/account/profile">
                                            <i class="bi bi-person"></i> Tài khoản
                                        </a></li>
                                        <li><a class="dropdown-item" href="/account/orders">
                                            <i class="bi bi-bag"></i> Đơn hàng
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        {{#ifEqual user.role 'admin'}}
                                        <li><a class="dropdown-item" href="/admin">
                                            <i class="bi bi-gear"></i> Quản trị
                                        </a></li>
                                        {{/ifEqual}}
                                        {{#ifEqual user.role 'staff'}}
                                        <li><a class="dropdown-item" href="/staff">
                                            <i class="bi bi-tools"></i> Nhân viên
                                        </a></li>
                                        {{/ifEqual}}
                                        <li>
                                            <form action="/account/logout" method="POST" class="d-inline">
                                                <button type="submit" class="dropdown-item border-0 bg-transparent">
                                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            {{else}}
                                <a href="/account/login" class="text-decoration-none">Đăng nhập</a>
                                <span class="mx-1">|</span>
                                <a href="/account/register" class="text-decoration-none">Đăng ký</a>
                            {{/if}}
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Navigation -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand fw-bold text-primary" href="/">
                    <i class="bi bi-heart-fill"></i> PetShop
                </a>

                <!-- Search Bar -->
                <div class="mx-4 flex-grow-1">
                    <form action="/products/search" method="GET" class="d-flex">
                        <input class="form-control me-2" type="search" name="q" placeholder="Tìm sản phẩm..." aria-label="Search">
                        <button class="btn btn-outline-primary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>

                <!-- Navigation Links -->
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" href="/">
                        <i class="bi bi-house"></i> Trang chủ
                    </a>
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-grid"></i> Danh mục
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/products/category/thuc-an-cho-cho">Thức ăn cho chó</a></li>
                            <li><a class="dropdown-item" href="/products/category/thuc-an-cho-meo">Thức ăn cho mèo</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/products/category/do-choi">Đồ chơi</a></li>
                            <li><a class="dropdown-item" href="/products/category/phu-kien">Phụ kiện</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/products/category/ve-sinh-cham-soc">Vệ sinh & Chăm sóc</a></li>
                            <li><a class="dropdown-item" href="/products/category/suc-khoe-thuoc">Sức khỏe & Thuốc</a></li>
                        </ul>
                    </div>
                    <a class="nav-link" href="/products">
                        <i class="bi bi-shop"></i> Sản phẩm
                    </a>
                    
                    <!-- User Actions -->
                    <div class="d-flex ms-3">
                        <a class="nav-link position-relative" href="/user/wishlist">
                            <i class="bi bi-heart"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                0
                            </span>
                        </a>
                        <a class="nav-link position-relative" href="/cart">
                            <i class="bi bi-cart3"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                {{cartItemsCount}}
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Flash Messages -->
    {{#if success}}
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{{success}}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
    {{/if}}

    {{#if error}}
    <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{{error}}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
    {{/if}}

    <!-- Main Content -->
    <main class="flex-shrink-0">
        {{{body}}}
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold">
                        <i class="bi bi-heart-fill text-primary"></i> PetShop
                    </h5>
                    <p class="text-muted">Cung cấp các sản phẩm chất lượng cao cho thú cưng của bạn.</p>
                    <div class="social-links">
                        <a href="#" class="text-light me-3"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-light me-3"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-light me-3"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
                
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Mua sắm</h6>
                    <ul class="list-unstyled">
                        <li><a href="/products/category/thuc-an-cho-cho" class="text-decoration-none text-muted">Thức ăn cho chó</a></li>
                        <li><a href="/products/category/thuc-an-cho-meo" class="text-decoration-none text-muted">Thức ăn cho mèo</a></li>
                        <li><a href="/products/category/do-choi" class="text-decoration-none text-muted">Đồ chơi</a></li>
                        <li><a href="/products/category/phu-kien" class="text-decoration-none text-muted">Phụ kiện</a></li>
                        <li><a href="/products/category/ve-sinh-cham-soc" class="text-decoration-none text-muted">Vệ sinh & Chăm sóc</a></li>
                        <li><a href="/products/category/suc-khoe-thuoc" class="text-decoration-none text-muted">Sức khỏe & Thuốc</a></li>
                    </ul>
                </div>
                
                <div class="col-md-3 mb-4">
                    <h6 class="fw-bold">Hỗ trợ</h6>
                    <ul class="list-unstyled">
                        <li><a href="/about" class="text-decoration-none text-muted">Về chúng tôi</a></li>
                        <li><a href="/contact" class="text-decoration-none text-muted">Liên hệ</a></li>
                        <li><a href="/shipping" class="text-decoration-none text-muted">Chính sách vận chuyển</a></li>
                        <li><a href="/return" class="text-decoration-none text-muted">Chính sách đổi trả</a></li>
                    </ul>
                </div>
                
                <div class="col-md-3 mb-4">
                    <h6 class="fw-bold">Liên hệ</h6>
                    <ul class="list-unstyled text-muted">
                        <li><i class="bi bi-geo-alt"></i> 123 Đường ABC, TP.HCM</li>
                        <li><i class="bi bi-telephone"></i> 1900 1234</li>
                        <li><i class="bi bi-envelope"></i> contact@petshop.com</li>
                        <li><i class="bi bi-clock"></i> 8:00 - 22:00</li>
                    </ul>
                </div>
            </div>
            
            <hr class="my-4">
            
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="text-muted mb-0">&copy; 2024 PetShop. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-end">
                    <img src="/static/imgs/payment-methods.png" alt="Payment Methods" height="30" class="me-2">
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom JS -->
    <script>
        // Auto-hide alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
        });
    </script>
</body>
</html>