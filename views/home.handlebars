<!-- views/home.handlebars -->

<!-- Hero Banner/Slider -->
<section class="mb-5">
  <div id="homeCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
      {{#if banners.length}}
        {{#each banners}}
        <div class="carousel-item {{#if @first}}active{{/if}}">
          <img src="{{this.image_url}}" class="d-block w-100" alt="{{this.title}}" style="height: 500px; object-fit: cover;">
          <div class="carousel-caption d-none d-md-block">
            <h2>{{this.title}}</h2>
            <p>{{this.subtitle}}</p>
            {{#if this.target_url}}
            <a href="{{this.target_url}}" class="btn btn-primary btn-lg">Mua ngay</a>
            {{/if}}
          </div>
        </div>
        {{/each}}
      {{else}}
        <div class="carousel-item active">
          <img src="/static/imgs/banners/slide-1.png" class="d-block w-100" alt="PetShop" style="height: 500px; object-fit: cover;">
          <div class="carousel-caption d-none d-md-block">
            <h2>Chào mừng đến với PetShop</h2>
            <p>Nơi cung cấp các sản phẩm chất lượng cho thú cưng của bạn</p>
            <a href="/products" class="btn btn-primary btn-lg">Mua sắm ngay</a>
          </div>
        </div>
      {{/if}}
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
</section>

<!-- Featured Products -->
<section class="mb-5">
  <div class="container">
    <div class="row mb-4">
      <div class="col">
        <h2 class="text-center fw-bold">Sản Phẩm Nổi Bật</h2>
        <p class="text-center text-muted">Những sản phẩm được yêu thích nhất</p>
      </div>
    </div>
    
    <div class="row g-4">
      {{#each featuredProducts}}
      <div class="col-lg-3 col-md-4 col-sm-6">
        <div class="card h-100 product-card">
          {{#if this.discount_price}}
          <span class="badge bg-danger position-absolute top-0 start-0 m-2">Giảm giá</span>
          {{/if}}
          
          <img src="{{this.main_image_url}}" class="card-img-top" alt="{{this.name}}" style="height: 200px; object-fit: cover;">
          
          <div class="card-body d-flex flex-column">
            <h6 class="card-title">{{this.name}}</h6>
            <p class="card-text text-muted small flex-grow-1">{{this.short_description}}</p>
            
            <div class="mb-2">
              {{#if this.discount_price}}
              <div class="d-flex align-items-center">
                <strong class="text-danger me-2">{{formatCurrency this.discount_price}}</strong>
                <small class="text-muted text-decoration-line-through">{{formatCurrency this.price}}</small>
              </div>
              {{else}}
              <strong class="text-primary">{{formatCurrency this.price}}</strong>
              {{/if}}
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-2">
              <small class="text-muted">
                <i class="bi bi-star-fill text-warning"></i>
                {{this.average_rating}} ({{this.review_count}})
              </small>
              <small class="text-muted">
                {{this.stock_quantity}} trong kho
              </small>
            </div>
            
            <div class="mt-auto">
              <button class="btn btn-outline-primary btn-sm w-100 mb-2" 
                      onclick="addToCart({{this.id}}, 1)">
                <i class="bi bi-cart-plus"></i> Thêm giỏ hàng
              </button>
              <a href="/products/{{this.slug}}" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-eye"></i> Xem chi tiết
              </a>
            </div>
          </div>
        </div>
      </div>
      {{else}}
      <div class="col-12">
        <div class="text-center py-5">
          <i class="bi bi-box-seam display-1 text-muted"></i>
          <p class="text-muted mt-3">Chưa có sản phẩm nổi bật</p>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

