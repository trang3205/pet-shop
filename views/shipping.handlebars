<div class="container py-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/contact" class="text-decoration-none">Liên hệ</a></li>
            <li class="breadcrumb-item active">Chính sách vận chuyển</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">
            <i class="bi bi-truck"></i> Chính sách vận chuyển
        </h1>
        <p class="lead text-muted">
            Chúng tôi cam kết giao hàng nhanh, an toàn và đúng hẹn
        </p>
    </div>

    <!-- Quick Info -->
    <div class="row mb-5 g-4">
        <div class="col-md-3">
            <div class="card border-0 bg-primary bg-opacity-10 text-center">
                <div class="card-body p-4">
                    <div class="display-5 text-primary mb-2">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h6 class="card-title fw-bold">Đóng gói chuyên nghiệp</h6>
                    <p class="card-text small text-muted">Bảo vệ sản phẩm tối đa</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-success bg-opacity-10 text-center">
                <div class="card-body p-4">
                    <div class="display-5 text-success mb-2">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <h6 class="card-title fw-bold">Giao hàng nhanh</h6>
                    <p class="card-text small text-muted">1-3 ngày làm việc</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-warning bg-opacity-10 text-center">
                <div class="card-body p-4">
                    <div class="display-5 text-warning mb-2">
                        <i class="bi bi-percent"></i>
                    </div>
                    <h6 class="card-title fw-bold">Miễn phí vận chuyển</h6>
                    <p class="card-text small text-muted">Từ 500.000đ trở lên</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-info bg-opacity-10 text-center">
                <div class="card-body p-4">
                    <div class="display-5 text-info mb-2">
                        <i class="bi bi-eye"></i>
                    </div>
                    <h6 class="card-title fw-bold">Theo dõi đơn hàng</h6>
                    <p class="card-text small text-muted">Realtime tracking</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="row">
        <div class="col-lg-8">
            <!-- Shipping Methods -->
            <section class="mb-5">
                <h2 class="fw-bold mb-4">
                    <i class="bi bi-box-seam"></i> Các phương thức vận chuyển
                </h2>

                <div class="accordion" id="shippingAccordion">
                    <!-- Standard Shipping -->
                    <div class="accordion-item mb-3 border rounded shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#shipping1">
                                <i class="bi bi-truck me-2 text-primary"></i> Vận chuyển tiêu chuẩn
                            </button>
                        </h2>
                        <div id="shipping1" class="accordion-collapse collapse show" data-bs-parent="#shippingAccordion">
                            <div class="accordion-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <p><strong>Thời gian giao hàng:</strong> 1-3 ngày làm việc</p>
                                        <p><strong>Phí vận chuyển:</strong></p>
                                        <ul class="list-unstyled ms-3">
                                            <li>• Miễn phí với đơn từ 500.000đ</li>
                                            <li>• 30.000đ cho đơn dưới 500.000đ (ngoài Hà Nội, TP.HCM)</li>
                                            <li>• 20.000đ cho đơn dưới 500.000đ (Hà Nội, TP.HCM)</li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Áp dụng cho:</strong> Toàn quốc</p>
                                        <p><strong>Đối tác vận chuyển:</strong></p>
                                        <ul class="list-unstyled ms-3">
                                            <li>•  Giao hàng Nhanh</li>
                                            <li>•  Viettel Post</li>
                                            <li>•  AhaMove</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Express Shipping -->
                    <div class="accordion-item mb-3 border rounded shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#shipping2">
                                <i class="bi bi-lightning-charge me-2 text-success"></i> Vận chuyển nhanh (Express)
                            </button>
                        </h2>
                        <div id="shipping2" class="accordion-collapse collapse" data-bs-parent="#shippingAccordion">
                            <div class="accordion-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <p><strong>Thời gian giao hàng:</strong> Cùng ngày/Hôm sau</p>
                                        <p><strong>Phí vận chuyển:</strong></p>
                                        <ul class="list-unstyled ms-3">
                                            <li>• 50.000đ - 100.000đ tùy khoảng cách</li>
                                            <li>• Miễn phí với đơn từ 1.000.000đ</li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Áp dụng cho:</strong> Hà Nội, TP.HCM, Hải Phòng, Đà Nẵng</p>
                                        <p><strong>Đối tác vận chuyển:</strong></p>
                                        <ul class="list-unstyled ms-3">
                                            <li>• <i class="bi bi-dot"></i> Ahamove</li>
                                            <li>• <i class="bi bi-dot"></i> Grab</li>
                                        </ul>
                                    </div>
                                </div>
                                <p class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle"></i> Vui lòng đặt hàng trước 12h trưa để được giao cùng ngày
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Pickup -->
                    <div class="accordion-item mb-3 border rounded shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#shipping3">
                                <i class="bi bi-shop me-2 text-warning"></i> Tự đến lấy (Pickup)
                            </button>
                        </h2>
                        <div id="shipping3" class="accordion-collapse collapse" data-bs-parent="#shippingAccordion">
                            <div class="accordion-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <p><strong>Thời gian:</strong> Vào giờ hành chính (8h-22h hàng ngày)</p>
                                        <p><strong>Phí:</strong> Miễn phí</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Địa điểm:</strong></p>
                                        <ul class="list-unstyled ms-3">
                                            <li>• TP.HCM : 1 Võ Văn ngân Thủ Đức</li>
                                        </ul>
                                    </div>
                                </div>
                                <p class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle"></i> Vui lòng liên hệ trước 24 giờ để xác nhận
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Delivery Process -->
            <section class="mb-5">
                <h2 class="fw-bold mb-4">
                    <i class="bi bi-diagram-3"></i> Quy trình vận chuyển
                </h2>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex mb-4">
                            <div class="display-6 text-primary fw-bold me-3">1</div>
                            <div>
                                <h6 class="fw-bold">Xác nhận đơn hàng</h6>
                                <p class="text-muted small">Chúng tôi xác nhận đơn hàng của bạn ngay sau khi bạn thanh toán</p>
                            </div>
                        </div>

                        <div class="d-flex mb-4">
                            <div class="display-6 text-primary fw-bold me-3">2</div>
                            <div>
                                <h6 class="fw-bold">Đóng gói hàng</h6>
                                <p class="text-muted small">Sản phẩm được kiểm tra và đóng gói cẩn thận</p>
                            </div>
                        </div>

                        <div class="d-flex mb-4">
                            <div class="display-6 text-primary fw-bold me-3">3</div>
                            <div>
                                <h6 class="fw-bold">In đơn vận chuyển</h6>
                                <p class="text-muted small">Tạo mã vận đơn để theo dõi hàng</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="d-flex mb-4">
                            <div class="display-6 text-success fw-bold me-3">4</div>
                            <div>
                                <h6 class="fw-bold">Gửi đi vận chuyển</h6>
                                <p class="text-muted small">Bàn giao cho đối tác vận chuyển</p>
                            </div>
                        </div>

                        <div class="d-flex mb-4">
                            <div class="display-6 text-success fw-bold me-3">5</div>
                            <div>
                                <h6 class="fw-bold">Vận chuyển</h6>
                                <p class="text-muted small">Hàng được vận chuyển đến nơi ghi trên đơn</p>
                            </div>
                        </div>

                        <div class="d-flex mb-4">
                            <div class="display-6 text-success fw-bold me-3">6</div>
                            <div>
                                <h6 class="fw-bold">Giao hàng thành công</h6>
                                <p class="text-muted small">Bạn nhận được hàng và có thể kiểm tra</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Important Notes -->
            <section class="mb-5">
                <h2 class="fw-bold mb-4">
                    <i class="bi bi-exclamation-triangle"></i> Những điều cần lưu ý
                </h2>

                <div class="alert alert-warning border-2">
                    <h6 class="fw-bold mb-3"><i class="bi bi-lightbulb"></i> Kiểm tra hàng khi nhận</h6>
                    <ul class="mb-0 ms-3">
                        <li>Kiểm tra số lượng sản phẩm</li>
                        <li>Kiểm tra tình trạng bao bì</li>
                        <li>Kiểm tra hạn sử dụng (nếu có)</li>
                        <li>Nếu có vấn đề, yêu cầu hoàn trả ngay</li>
                    </ul>
                </div>

                <div class="alert alert-info border-2">
                    <h6 class="fw-bold mb-3"><i class="bi bi-info-circle"></i> Địa chỉ giao hàng</h6>
                    <ul class="mb-0 ms-3">
                        <li>Địa chỉ phải rõ ràng, đầy đủ</li>
                        <li>Vui lòng cung cấp số điện thoại liên hệ</li>
                        <li>Không giao hàng tới các khu vực hạn chế</li>
                    </ul>
                </div>

                <div class="alert alert-danger border-2">
                    <h6 class="fw-bold mb-3"><i class="bi bi-exclamation-circle"></i> Trường hợp không giao được</h6>
                    <ul class="mb-0 ms-3">
                        <li>Nếu không giao được, chúng tôi sẽ liên hệ bạn</li>
                        <li>Hàng sẽ được bảo quản trong 7 ngày</li>
                        <li>Sau đó sẽ được hoàn tiền (nếu thanh toán) hoặc hoàn lại kho</li>
                    </ul>
                </div>
            </section>

            <!-- Tracking -->
            <section>
                <h2 class="fw-bold mb-4">
                    <i class="bi bi-eye"></i> Theo dõi đơn hàng
                </h2>

                <p class="text-muted mb-3">
                    Sau khi đơn hàng được gửi đi, bạn sẽ nhận được email chứa mã vận đơn. 
                    Bạn có thể sử dụng mã này để theo dõi tình trạng đơn hàng trên:
                </p>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm text-center">
                            <div class="card-body p-3">
                                <h6 class="fw-bold mb-2">Website PetShop</h6>
                                <p class="text-muted small mb-0">Mục "Đơn hàng của tôi"</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm text-center">
                            <div class="card-body p-3">
                                <h6 class="fw-bold mb-2">Website vận chuyển</h6>
                                <p class="text-muted small mb-0">Nhập mã vận đơn</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm text-center">
                            <div class="card-body p-3">
                                <h6 class="fw-bold mb-2">Liên hệ PetShop</h6>
                                <p class="text-muted small mb-0">Gọi hoặc chat với chúng tôi</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Help Card -->
            <div class="card border-0 shadow-sm position-sticky" style="top: 20px;">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-4">
                        <i class="bi bi-question-circle"></i> Cần giúp đỡ?
                    </h5>

                    <div class="d-grid gap-2">
                        <a href="/contact" class="btn btn-primary">
                            <i class="bi bi-envelope"></i> Liên hệ chúng tôi
                        </a>
                        <a href="tel:+84912345678" class="btn btn-outline-primary">
                            <i class="bi bi-telephone"></i> Gọi ngay
                        </a>
                    </div>

                    <hr>

                    <h6 class="fw-bold mb-3">Thông tin liên hệ</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2">
                            <i class="bi bi-telephone text-primary"></i>
                            <strong>Hotline:</strong> 0363 300 905
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-envelope text-primary"></i>
                            <strong>Email:</strong> support@petshop.com
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-clock text-primary"></i>
                            <strong>Giờ:</strong> 8:00 - 22:00
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Related Links -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-4">
                        <i class="bi bi-link"></i> Chính sách khác
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a href="/about" class="text-decoration-none text-primary">
                                <i class="bi bi-chevron-right"></i> Về chúng tôi
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/contact" class="text-decoration-none text-primary">
                                <i class="bi bi-chevron-right"></i> Liên hệ
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="/return" class="text-decoration-none text-primary">
                                <i class="bi bi-chevron-right"></i> Chính sách đổi trả
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .accordion-button:not(.collapsed) {
        background-color: #e7f1ff;
        color: #0d6efd;
    }

    .accordion-button:focus {
        box-shadow: none;
        border-color: #0d6efd;
    }

    .accordion-item {
        transition: all 0.3s ease;
    }

    .accordion-item:hover {
        transform: translateX(5px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1) !important;
    }
</style>
