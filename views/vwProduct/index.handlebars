<!-- views/vwProduct/index.handlebars -->
<div class="container mt-4">
  <div class="row">
    <!-- Sidebar Filters -->
    <div class="col-lg-3 mb-4">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-filter"></i> Bộ lọc</h5>
        </div>
        <div class="card-body">
          <!-- Categories Filter -->
          <h6 class="fw-bold mb-3">Danh mục</h6>
          <div class="list-group list-group-flush">
            <a href="/products" 
               class="list-group-item list-group-item-action {{#unless currentCategory}}active{{/unless}}">
              Tất cả sản phẩm
            </a>
            {{#each categories}}
            <a href="/products/category/{{this.slug}}" 
               class="list-group-item list-group-item-action {{#ifEqual this.slug ../currentCategory}}active{{/ifEqual}}">
              {{this.name}}
            </a>
            {{/each}}
          </div>

          <!-- Sorting -->
          <h6 class="fw-bold mt-4 mb-3">Sắp xếp</h6>
          <div class="list-group list-group-flush">
            <a href="?sort=newest{{#if currentCategory}}&category={{currentCategory}}{{/if}}" 
               class="list-group-item list-group-item-action {{#ifEqual currentSort 'newest'}}active{{/ifEqual}}">
              Mới nhất
            </a>
            <a href="?sort=price_asc{{#if currentCategory}}&category={{currentCategory}}{{/if}}" 
               class="list-group-item list-group-item-action {{#ifEqual currentSort 'price_asc'}}active{{/ifEqual}}">
              Giá thấp đến cao
            </a>
            <a href="?sort=price_desc{{#if currentCategory}}&category={{currentCategory}}{{/if}}" 
               class="list-group-item list-group-item-action {{#ifEqual currentSort 'price_desc'}}active{{/ifEqual}}">
              Giá cao đến thấp
            </a>
            <a href="?sort=name{{#if currentCategory}}&category={{currentCategory}}{{/if}}" 
               class="list-group-item list-group-item-action {{#ifEqual currentSort 'name'}}active{{/ifEqual}}">
              Tên A-Z
            </a>
            <a href="?sort=rating{{#if currentCategory}}&category={{currentCategory}}{{/if}}" 
               class="list-group-item list-group-item-action {{#ifEqual currentSort 'rating'}}active{{/ifEqual}}">
              Đánh giá cao
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Products Grid -->
    <div class="col-lg-9">
      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-1">
            {{#if category}}
              {{category.name}}
            {{else}}
              Sản phẩm
            {{/if}}
          </h1>
          <p class="text-muted mb-0">
            {{#if currentCategory}}
              {{#each categories}}
                {{#ifEqual this.slug ../currentCategory}}
                  Danh mục: {{this.name}}
                {{/ifEqual}}
              {{/each}}
            {{else}}
              Tất cả sản phẩm
            {{/if}}
            ({{pagination.total}} sản phẩm)
          </p>
        </div>
        <div class="text-muted">
          Trang {{pagination.page}} / {{pagination.pages}}
        </div>
      </div>

      <!-- Products Grid -->
      {{#if products.length}}
      <div class="row g-4">
        {{#each products}}
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="card h-100 product-card">
            {{#if this.discount_price}}
            <span class="badge bg-danger position-absolute top-0 start-0 m-2">Giảm giá</span>
            {{/if}}
            {{#if this.is_featured}}
            <span class="badge bg-warning position-absolute top-0 end-0 m-2">Nổi bật</span>
            {{/if}}
            
            <img src="{{this.main_image_url}}" class="card-img-top" alt="{{this.name}}" style="height: 200px; object-fit: cover;">
            
            <div class="card-body d-flex flex-column">
              <h6 class="card-title">{{this.name}}</h6>
              <small class="text-muted mb-2">{{this.category_name}}</small>
              <p class="card-text text-muted small flex-grow-1">{{this.short_description}}</p>
              
              <div class="mb-2">
                {{#if this.discount_price}}
                <div class="d-flex align-items-center">
                  <strong class="text-danger me-2">{{formatCurrency this.discount_price}}</strong>
                  <small class="text-muted text-decoration-line-through">{{formatCurrency this.price}}</small>
                </div>
                {{else}}
                <strong class="text-primary">{{formatCurrency this.price}}</strong>
                {{/if}}
              </div>
              
              <div class="d-flex justify-content-between align-items-center mb-2">
                <small class="text-muted">
                  <i class="bi bi-star-fill text-warning"></i>
                  {{this.average_rating}} ({{this.review_count}})
                </small>
                <small class="text-muted">
                  {{this.stock_quantity}} trong kho
                </small>
              </div>
              
              <div class="mt-auto">
                <button class="btn btn-outline-primary btn-sm w-100 mb-2" 
                        onclick="addToCart({{this.id}}, 1)">
                  <i class="bi bi-cart-plus"></i> Thêm giỏ hàng
                </button>
                <a href="/products/{{this.slug}}" class="btn btn-primary btn-sm w-100">
                  <i class="bi bi-eye"></i> Xem chi tiết
                </a>
              </div>
            </div>
          </div>
        </div>
        {{/each}}
      </div>

      <!-- Pagination - Simple version -->
      {{#if pagination.pages}}
        {{#ifEqual pagination.pages 1}}
          <!-- Only one page, no pagination needed -->
        {{else}}
        <nav class="mt-5">
          <ul class="pagination justify-content-center">
            {{#if pagination.page}}
              {{#ifEqual pagination.page 1}}
                <!-- First page, no previous -->
              {{else}}
              <li class="page-item">
                <a class="page-link" href="?page={{pagination.page}}-1{{#if currentCategory}}&category={{currentCategory}}{{/if}}{{#if currentSort}}&sort={{currentSort}}{{/if}}">
                  <i class="bi bi-chevron-left"></i>
                </a>
              </li>
              {{/ifEqual}}
            {{/if}}

            <!-- Simple page numbers -->
            {{#each (arrayRange pagination.pages)}}
            <li class="page-item {{#ifEqual this ../pagination.page}}active{{/ifEqual}}">
              <a class="page-link" href="?page={{this}}{{#if ../currentCategory}}&category={{../currentCategory}}{{/if}}{{#if ../currentSort}}&sort={{../currentSort}}{{/if}}">
                {{this}}
              </a>
            </li>
            {{/each}}

            {{#if pagination.page}}
              {{#ifEqual pagination.page pagination.pages}}
                <!-- Last page, no next -->
              {{else}}
              <li class="page-item">
                <a class="page-link" href="?page={{pagination.page}}+1{{#if currentCategory}}&category={{currentCategory}}{{/if}}{{#if currentSort}}&sort={{currentSort}}{{/if}}">
                  <i class="bi bi-chevron-right"></i>
                </a>
              </li>
              {{/ifEqual}}
            {{/if}}
          </ul>
        </nav>
        {{/ifEqual}}
      {{/if}}

      {{else}}
      <div class="text-center py-5">
        <i class="bi bi-search display-1 text-muted"></i>
        <h4 class="text-muted mt-3">Không tìm thấy sản phẩm</h4>
        <p class="text-muted">Hãy thử tìm kiếm với bộ lọc khác</p>
        <a href="/products" class="btn btn-primary">Xem tất cả sản phẩm</a>
      </div>
      {{/if}}
    </div>
  </div>
</div>

<script>
// Function để thêm sản phẩm vào giỏ hàng
async function addToCart(productId, quantity) {
  try {
    const response = await fetch('/cart/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        product_id: productId,
        quantity: quantity
      })
    });

    const result = await response.json();
    
    if (result.success) {
      showAlert('Đã thêm sản phẩm vào giỏ hàng!', 'success');
      updateCartCount(result.cartItemsCount);
    } else {
      showAlert(result.message || 'Có lỗi xảy ra!', 'error');
    }
  } catch (error) {
    console.error('Error adding to cart:', error);
    showAlert('Có lỗi xảy ra khi thêm vào giỏ hàng!', 'error');
  }
}

function showAlert(message, type) {
  const alertDiv = document.createElement('div');
  alertDiv.className = `alert alert-${type === 'error' ? 'danger' : 'success'} alert-dismissible fade show position-fixed`;
  alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
  alertDiv.innerHTML = `
    ${message}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  `;
  
  document.body.appendChild(alertDiv);
  
  setTimeout(() => {
    if (alertDiv.parentNode) {
      alertDiv.parentNode.removeChild(alertDiv);
    }
  }, 3000);
}

function updateCartCount(count) {
  const cartBadge = document.querySelector('.cart-badge');
  if (cartBadge) {
    cartBadge.textContent = count;
  }
}
</script>